# kora Control Plane - Development Makefile
# ===========================================

# Load environment variables from .env if it exists
-include .env
export

# Go parameters
GOCMD=go
GOBUILD=$(GOCMD) build
GOCLEAN=$(GOCMD) clean
GOTEST=$(GOCMD) test
GOGET=$(GOCMD) get
GOMOD=$(GOCMD) mod
GOFMT=gofmt
GOLINT=golangci-lint

# Project directories
BACKEND_DIR=./backend
FRONTEND_DIR=./frontend

# Binary output
BINARY_DIR=.bin

# Tool versions live in versions.hcl, which docker buildx bake also reads. HCL
# quotes each value, so strip the quotes after the include.
include versions.hcl
$(foreach v,$(shell sed -n 's/^\([A-Z_]*\) *=.*/\1/p' versions.hcl),$(eval $(v) := $(patsubst "%",%,$($(v)))))

# Backing-service defaults. `.env` holds only machine-local secrets, so these
# mirror the defaults in docker-compose.yml and are overridable from .env.
DB_HOST ?= localhost
DB_PORT ?= 5432
DB_USER ?= orbit
DB_NAME ?= orbit
DB_PASSWORD ?= orbit
REDIS_HOST ?= localhost
REDIS_PORT ?= 6379
REDIS_PASSWORD ?= orbit

# Database connection string
DB_URL=postgres://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)?sslmode=disable


# Frontend public URL — baked into the Next.js client bundle at Docker build time.
# Override for non-local environments (e.g. CI): NEXT_PUBLIC_APP_URL=https://my.host docker buildx bake -f docker-bake.hcl -f versions.hcl orbit-frontend
NEXT_PUBLIC_APP_URL ?= https://orbit.local.clearroute.io:8443

# Docker image publishing (generic backend/Dockerfile via docker buildx bake)
DOCKER_BAKE_FILE ?= docker-bake.hcl
IMAGE_REGISTRY ?= ghcr.io
IMAGE_NAMESPACE ?= clear-route
IMAGE_TAG ?= latest
IMAGE_REPOSITORY_PREFIX ?= $(IMAGE_REGISTRY)/$(IMAGE_NAMESPACE)/orbit-
BACKEND_IMAGE_GROUP ?= backend-images
DOCKER_BUILD_PLATFORMS ?= linux/amd64
DOCKER_PUSH_PLATFORMS ?= linux/amd64,linux/arm64

# Colors for output
COLOR_RESET=\033[0m
COLOR_BOLD=\033[1m
COLOR_RED=\033[31m
COLOR_GREEN=\033[32m
COLOR_YELLOW=\033[33m
COLOR_BLUE=\033[36m

.DEFAULT_GOAL := help

# ===========================================
# Help Target
# ===========================================

# The day-to-day targets come first. Everything else is listed below them, in
# file order. A new engineer should not have to read 100 targets to find `up`.
COMMON_TARGETS := setup up down reset auth redeploy test check

.PHONY: help
help: ## Display this help screen
	@echo "$(COLOR_BOLD)kora Control Plane$(COLOR_RESET)"
	@echo ""
	@echo "$(COLOR_BOLD)Start here$(COLOR_RESET)"
	@for t in $(COMMON_TARGETS); do \
		desc=$$(grep -Eh "^$$t:.*?## " $(MAKEFILE_LIST) | head -1 | sed 's/^[^#]*## //'); \
		printf "  $(COLOR_GREEN)%-20s$(COLOR_RESET) %s\n" "$$t" "$$desc"; \
	done
	@echo ""
	@echo "$(COLOR_BOLD)All targets$(COLOR_RESET)"
	@grep -Eh '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  $(COLOR_BLUE)%-20s$(COLOR_RESET) %s\n", $$1, $$2}'
	@echo ""

# ===========================================
# Setup & Installation
# ===========================================

# Generates .env rather than copying a template. Everything with a safe default
# lives in docker-compose.yml, so the file holds only machine-local secrets.
# Never overwrites: the Postgres volume bakes DB_PASSWORD at first init, and the
# cluster's orbit-secrets is built from these values.
.PHONY: env
env: ## Generate .env with machine-local secrets (existing .env keeps its values; missing keys are appended)
	@if [ -f .env ]; then \
		echo "$(COLOR_YELLOW).env already exists, leaving its values alone$(COLOR_RESET)"; \
		if ! grep -q '^ORBIT_TRIGGERS_ENCRYPTION_KEY=' .env; then \
			printf '\n%s\n%s\n%s\n' \
				"# At-rest key for webhook signing secrets. orbit-triggers refuses to" \
				"# start without it; there is no in-code fallback." \
				"ORBIT_TRIGGERS_ENCRYPTION_KEY=$$(openssl rand -base64 32)" >> .env; \
			echo "$(COLOR_GREEN)✓ appended a generated ORBIT_TRIGGERS_ENCRYPTION_KEY$(COLOR_RESET)"; \
			echo "$(COLOR_YELLOW)  Webhook sources created before this used the old built-in dev key and can no longer be decrypted; rotate their secrets.$(COLOR_RESET)"; \
		fi; \
	else \
		printf '%s\n' \
			"# Generated by 'make setup'. Machine-local and gitignored." \
			"# Everything with a safe default lives in docker-compose.yml." \
			"# See .env.example for the optional overrides." \
			"" \
			"# Local Postgres and Redis. Fixed, not secret: they listen on loopback," \
			"# and the Postgres volume bakes this password at first initialisation." \
			"DB_PASSWORD=orbit" \
			"REDIS_PASSWORD=orbit" \
			"" \
			"# Real secrets, generated per machine." \
			"BFF_SESSION_SECRET=$$(openssl rand -base64 32)" \
			"" \
			"# At-rest key for webhook signing secrets. orbit-triggers refuses to" \
			"# start without it; there is no in-code fallback." \
			"ORBIT_TRIGGERS_ENCRYPTION_KEY=$$(openssl rand -base64 32)" \
			> .env; \
		echo "$(COLOR_GREEN)✓ .env generated with machine-local secrets$(COLOR_RESET)"; \
	fi

.PHONY: setup
setup: env install-tools install-tools-cluster tidy frontend-install hooks setup-dns setup-tls ## Once per machine: generate .env, install tools, git hooks, local DNS and TLS
	@echo "$(COLOR_GREEN)✓ Setup complete$(COLOR_RESET)"
	@echo "$(COLOR_BLUE)Next: 'make up'$(COLOR_RESET)"
	@if [ ! -f secrets/tls.crt ]; then \
		echo "$(COLOR_YELLOW)Note: TLS certs were not generated (non-macOS without mkcert).$(COLOR_RESET)"; \
		echo "$(COLOR_YELLOW)      'make dev-up' will generate a self-signed fallback automatically.$(COLOR_RESET)"; \
	fi

.PHONY: setup-dns
setup-dns: ## Verify *.orbit.local.clearroute.io resolves (public wildcard record; no local DNS config needed)
	@chmod +x scripts/setup-dns.sh
	@bash scripts/setup-dns.sh

.PHONY: hooks
hooks: ## Configure git to use the project's tracked hooks from .githooks/, sign commits and add DCO sign-offs
	@git config core.hooksPath .githooks
	@echo "$(COLOR_GREEN)✓ Git hooks installed (.githooks/)$(COLOR_RESET)"
	@echo "Configuring DCO sign-off..."
	@if [ -n "$$(git config user.name)" ] && [ -n "$$(git config user.email)" ]; then \
		echo "$(COLOR_GREEN)✓ Commits are signed off as $$(git config user.name) <$$(git config user.email)>$(COLOR_RESET)"; \
	else \
		echo "$(COLOR_YELLOW)! Set git user.name and user.email so commits can be signed off, then run: make hooks$(COLOR_RESET)"; \
	fi
	@echo "Configuring commit signing..."
	@bash scripts/setup-signing.sh

# ===========================================
# Worktree Management
# ===========================================

.PHONY: worktree-new
worktree-new: ## Create a sibling worktree for a branch (usage: make worktree-new BRANCH=feature/my-feature)
	$(if $(BRANCH),,$(error BRANCH is required — usage: make worktree-new BRANCH=feature/my-feature))
	@SLUG=$$(echo "$(BRANCH)" | tr '/' '-'); \
	WORKTREE_DIR="../orbit-$$SLUG"; \
	if [ -d "$$WORKTREE_DIR" ]; then \
		echo "$(COLOR_YELLOW)⚠ Worktree already exists at $$WORKTREE_DIR$(COLOR_RESET)"; \
		exit 1; \
	fi; \
	echo "$(COLOR_YELLOW)Creating worktree for branch '$(BRANCH)'...$(COLOR_RESET)"; \
	git fetch origin main --quiet; \
	if git show-ref --verify --quiet "refs/heads/$(BRANCH)"; then \
		git worktree add "$$WORKTREE_DIR" "$(BRANCH)"; \
	elif git show-ref --verify --quiet "refs/remotes/origin/$(BRANCH)"; then \
		git worktree add --track -b "$(BRANCH)" "$$WORKTREE_DIR" "origin/$(BRANCH)"; \
	else \
		git worktree add -b "$(BRANCH)" "$$WORKTREE_DIR" origin/main; \
		git push origin "$(BRANCH)"; \
		git -C "$$WORKTREE_DIR" branch --set-upstream-to="origin/$(BRANCH)" "$(BRANCH)"; \
	fi; \
	echo "$(COLOR_YELLOW)Symlinking local dev files...$(COLOR_RESET)"; \
	ln -s "$(CURDIR)/.env" "$$WORKTREE_DIR/.env"; \
	ln -s "$(CURDIR)/secrets" "$$WORKTREE_DIR/secrets"; \
	mkdir -p "$$WORKTREE_DIR/config/dex"; \
	echo "$(COLOR_YELLOW)Configuring git hooks...$(COLOR_RESET)"; \
	git -C "$$WORKTREE_DIR" config core.hooksPath .githooks; \
	echo "$(COLOR_GREEN)✓ Worktree ready$(COLOR_RESET)"; \
	echo ""; \
	echo "  Branch:  $(BRANCH)"; \
	echo "  Path:    $$(cd "$$WORKTREE_DIR" && pwd)"; \
	echo ""; \
	echo "  Next steps:"; \
	echo "    cd $$WORKTREE_DIR && make dev-up"; \
	echo ""

.PHONY: worktree-remove
worktree-remove: ## Remove a sibling worktree (usage: make worktree-remove BRANCH=feature/my-feature [FORCE=1])
	$(if $(BRANCH),,$(error BRANCH is required — usage: make worktree-remove BRANCH=feature/my-feature))
	@SLUG=$$(echo "$(BRANCH)" | tr '/' '-'); \
	WORKTREE_DIR="../orbit-$$SLUG"; \
	if [ ! -d "$$WORKTREE_DIR" ]; then \
		echo "$(COLOR_YELLOW)⚠ No worktree found at $$WORKTREE_DIR$(COLOR_RESET)"; \
		exit 1; \
	fi; \
	echo "$(COLOR_YELLOW)Removing worktree for branch '$(BRANCH)'...$(COLOR_RESET)"; \
	if [ "$(FORCE)" = "1" ]; then \
		echo "$(COLOR_YELLOW)⚠ FORCE=1 set — uncommitted changes in the worktree will be lost.$(COLOR_RESET)"; \
		git worktree remove "$$WORKTREE_DIR" --force; \
	else \
		git worktree remove "$$WORKTREE_DIR" || { \
			echo "$(COLOR_RED)✗ Worktree has uncommitted changes. Commit or discard them first,$(COLOR_RESET)"; \
			echo "$(COLOR_RED)  or re-run with FORCE=1 to discard them:$(COLOR_RESET)"; \
			echo "$(COLOR_RED)    make worktree-remove BRANCH=$(BRANCH) FORCE=1$(COLOR_RESET)"; \
			exit 1; \
		}; \
	fi; \
	git worktree prune; \
	echo "$(COLOR_GREEN)✓ Worktree removed and refs pruned$(COLOR_RESET)"

.PHONY: worktree-list
worktree-list: ## List all active worktrees
	@git worktree list

.PHONY: install-tools
install-tools: ## Install development tools (golangci-lint, gitleaks, buf, protoc-gen-go)
	@echo "$(COLOR_YELLOW)Installing development tools...$(COLOR_RESET)"
	@echo "  Installing protoc-gen-go $(PROTOC_GEN_GO_VERSION)..."
	@$(GOCMD) install google.golang.org/protobuf/cmd/protoc-gen-go@$(PROTOC_GEN_GO_VERSION)
	@echo "  Installing protoc-gen-go-grpc $(PROTOC_GEN_GO_GRPC_VERSION)..."
	@$(GOCMD) install google.golang.org/grpc/cmd/protoc-gen-go-grpc@$(PROTOC_GEN_GO_GRPC_VERSION)
	@BUF_INSTALLED=$$(buf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$BUF_INSTALLED" != "$(BUF_VERSION:v%=%)" ]; then \
		echo "  Installing buf $(BUF_VERSION) (installed: $${BUF_INSTALLED:-none})..."; \
		BUF_OS=$$(uname -s); BUF_ARCH=$$(uname -m); \
		curl -sSfL --retry 3 "https://github.com/bufbuild/buf/releases/download/$(BUF_VERSION)/buf-$${BUF_OS}-$${BUF_ARCH}" \
			-o "$$(go env GOPATH)/bin/buf" && chmod +x "$$(go env GOPATH)/bin/buf"; \
	else \
		echo "  buf $(BUF_VERSION) already installed"; \
	fi
	@LINT_INSTALLED=$$(golangci-lint --version 2>&1 | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$LINT_INSTALLED" != "$(GOLANGCI_LINT_VERSION)" ]; then \
		echo "  Installing golangci-lint $(GOLANGCI_LINT_VERSION) (installed: $${LINT_INSTALLED:-none})..."; \
		curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $$(go env GOPATH)/bin $(GOLANGCI_LINT_VERSION); \
	else \
		echo "  golangci-lint $(GOLANGCI_LINT_VERSION) already installed"; \
	fi
	@GL_INSTALLED=$$(gitleaks version 2>&1 | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$GL_INSTALLED" != "$(GITLEAKS_VERSION)" ]; then \
		echo "  Installing gitleaks $(GITLEAKS_VERSION) (installed: $${GL_INSTALLED:-none})..."; \
		GL_TAG=$(GITLEAKS_VERSION); \
		GL_VER=$${GL_TAG#v}; \
		GL_OS=$$(uname -s | tr '[:upper:]' '[:lower:]'); \
		GL_ARCH=$$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/'); \
		GL_URL="https://github.com/gitleaks/gitleaks/releases/download/$${GL_TAG}/gitleaks_$${GL_VER}_$${GL_OS}_$${GL_ARCH}.tar.gz"; \
		curl -sSfL "$${GL_URL}" | tar -xz -C $$(go env GOPATH)/bin gitleaks; \
	else \
		echo "  gitleaks $(GITLEAKS_VERSION) already installed"; \
	fi
	@echo "$(COLOR_GREEN)✓ Tools installed$(COLOR_RESET)"

.PHONY: proto-gen
proto-gen: ## Generate Go code from proto files (requires buf — run make install-tools first)
	@echo "$(COLOR_YELLOW)Generating proto files...$(COLOR_RESET)"
	@cd backend && buf generate
	@echo "$(COLOR_GREEN)✓ Proto files generated$(COLOR_RESET)"

.PHONY: check-versions
check-versions: ## Verify GO_VERSION matches backend/go.mod
	@GOMOD=$$(awk '$$1 == "go" { print $$2; exit }' backend/go.mod); \
	if [ "$$GOMOD" != "$(GO_VERSION)" ]; then \
		echo "$(COLOR_RED)✗ versions.hcl GO_VERSION=$(GO_VERSION) but backend/go.mod has go $$GOMOD$(COLOR_RESET)"; \
		exit 1; \
	fi
	@echo "$(COLOR_GREEN)✓ GO_VERSION $(GO_VERSION) matches backend/go.mod$(COLOR_RESET)"

.PHONY: check-tool-versions
check-tool-versions: ## Verify installed tool versions match pinned versions in versions.hcl
	@echo "$(COLOR_YELLOW)Checking tool versions...$(COLOR_RESET)"
	@INSTALLED=$$(golangci-lint --version 2>&1 | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$INSTALLED" = "$(GOLANGCI_LINT_VERSION)" ]; then \
		echo "  $(COLOR_GREEN)✓ golangci-lint $$INSTALLED$(COLOR_RESET)"; \
	else \
		echo "  $(COLOR_YELLOW)⚠ golangci-lint: installed=$${INSTALLED:-none}  expected=$(GOLANGCI_LINT_VERSION) — run: make install-tools$(COLOR_RESET)"; \
	fi
	@INSTALLED=$$(gitleaks version 2>&1 | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$INSTALLED" = "$(GITLEAKS_VERSION)" ]; then \
		echo "  $(COLOR_GREEN)✓ gitleaks $$INSTALLED$(COLOR_RESET)"; \
	else \
		echo "  $(COLOR_YELLOW)⚠ gitleaks: installed=$${INSTALLED:-none}  expected=$(GITLEAKS_VERSION) — run: make install-tools$(COLOR_RESET)"; \
	fi
	@. scripts/cluster/versions.env && \
	INSTALLED=$$(helm version --short 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1); \
	if [ "$$INSTALLED" = "$${HELM_VERSION}" ]; then \
		echo "  $(COLOR_GREEN)✓ helm $$INSTALLED$(COLOR_RESET)"; \
	else \
		echo "  $(COLOR_YELLOW)⚠ helm: installed=$${INSTALLED:-none}  expected=$${HELM_VERSION} — run: make install-tools-cluster$(COLOR_RESET)"; \
	fi


.PHONY: tidy
tidy: ## Tidy and verify go.mod dependencies
	@echo "$(COLOR_YELLOW)Tidying dependencies...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOMOD) tidy
	@cd $(BACKEND_DIR) && $(GOMOD) verify
	@echo "$(COLOR_GREEN)✓ Dependencies tidied$(COLOR_RESET)"

# ===========================================
# Database Management
# ===========================================

.PHONY: db-up
db-up: ## Start the PostgreSQL database (docker-compose)
	@echo "$(COLOR_YELLOW)Starting database...$(COLOR_RESET)"
	@docker compose up -d --wait postgres
	@echo "$(COLOR_GREEN)✓ Database started and ready$(COLOR_RESET)"

.PHONY: db-down
db-down: ## Stop the PostgreSQL database
	@echo "$(COLOR_YELLOW)Stopping database...$(COLOR_RESET)"
	@docker compose down
	@echo "$(COLOR_GREEN)✓ Database stopped$(COLOR_RESET)"

.PHONY: db-reset
db-reset: ## DESTRUCTIVE: destroy the Postgres volume and recreate it. Every local database row is lost.
	@echo "$(COLOR_YELLOW)Resetting database...$(COLOR_RESET)"
	@docker compose down -v
	@docker compose up -d --wait postgres
	@$(MAKE) --no-print-directory schema-reset-marker
	@echo "$(COLOR_GREEN)✓ Database reset complete$(COLOR_RESET)"

# Helmfile only upgrades a release whose rendered output changed, and the
# migrate hook only runs on an upgrade. After the database is destroyed the
# chart is unchanged, so an annotation on the Job carries the reset time; the
# next `make up` renders a different Job and the hook re-applies the schema.
.PHONY: schema-reset-marker
schema-reset-marker:
	@[ -f deploy/reference/environments/local.generated.yaml ] || echo "{}" > deploy/reference/environments/local.generated.yaml
	@yq -i '.migrate.podAnnotations."orbit.io/schema-reset" = "'"$$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"' deploy/reference/environments/local.generated.yaml

.PHONY: db-logs
db-logs: ## Show database logs
	@docker compose logs -f postgres

.PHONY: db-shell
db-shell: ## Open a psql shell to the database
	@docker compose exec postgres psql -U $${DB_USER:-orbit} -d $${DB_NAME:-orbit}

# cmd/migrate embeds every service's migrations and is what the chart runs as a
# pre-upgrade hook (docs/adr/2026-09-10-database-migrations.md). Locally it
# runs through `go run` against the compose Postgres, whose address is in
# backend/internal/platform/storage/config/local.yaml.
MIGRATE_ENV = APP_ENV=local DB_PASSWORD=$(DB_PASSWORD)
MIGRATE = cd $(BACKEND_DIR) && $(MIGRATE_ENV) $(GOCMD) run ./cmd/migrate

.PHONY: migrate-status
migrate-status: ## Show applied and pending migrations against the local Postgres
	@$(MIGRATE) status

.PHONY: migrate-lint
migrate-lint: ## Check every migration against the content rule (DDL only, own tables, coupled backfills)
	@echo "$(COLOR_YELLOW)Linting migrations...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOCMD) run ./cmd/migrate lint
	@echo "$(COLOR_GREEN)✓ Migrations pass the content rule$(COLOR_RESET)"

.PHONY: migrate-create
migrate-create: ## Create a new migration (usage: make migrate-create service=identity name=migration_name)
	@if [ -z "$(name)" ] || [ -z "$(service)" ]; then \
		echo "$(COLOR_YELLOW)Usage: make migrate-create service=<service> name=<migration_name>$(COLOR_RESET)"; \
		echo "$(COLOR_YELLOW)  e.g. make migrate-create service=identity name=add_sessions_index$(COLOR_RESET)"; \
		exit 1; \
	fi
	@cd $(BACKEND_DIR) && $(GOCMD) run ./cmd/migrate create --service $(service) $(name)
	@echo "$(COLOR_GREEN)✓ Migration created in backend/cmd/$(service)/migrations/$(COLOR_RESET)"

# The migrate image is rebuilt and the orbit release re-applied only when the
# migration files changed since the last push. redeploy.sh records the content
# hash beside the digest in local.generated.yaml. A redeploy of any service on
# a branch that added a migration fires the hook before the service boots
# against the stale schema.
.PHONY: redeploy-migrate-if-changed
redeploy-migrate-if-changed: ## Rebuild the migrate image and re-apply the orbit release when the migration files changed
	@HASH=$$(bash scripts/cluster/migrations-hash.sh); \
	RECORDED=$$(yq -r '.migrate.sourceHash // ""' deploy/reference/environments/local.generated.yaml 2>/dev/null); \
	if [ "$$HASH" = "$$RECORDED" ]; then \
		echo "$(COLOR_BLUE)ℹ migrations unchanged ($$HASH), migrate image not rebuilt$(COLOR_RESET)"; \
	elif [ -n "$(NO_BUILD)$(BUILD_ONLY)" ]; then \
		echo "$(COLOR_RED)✗ migrations changed; NO_BUILD and BUILD_ONLY cannot apply them. Run: make redeploy-migrate$(COLOR_RESET)"; exit 1; \
	else \
		bash scripts/cluster/redeploy.sh migrate; \
	fi

.PHONY: redeploy-migrate
redeploy-migrate: ## Rebuild the migrate image and re-apply the orbit release so the schema hook runs
	@bash scripts/cluster/redeploy.sh migrate $(REDEPLOY_FLAGS)

# ===========================================
# Backing services (Postgres, Redis, Dex, glauth) via docker-compose
# ===========================================

.PHONY: dev-up
dev-up: ## Start Postgres + Redis + glauth + Dex (local OIDC provider) for daily Go development
	@if [ ! -f secrets/signing.key ]; then \
		echo "$(COLOR_YELLOW)→ secrets/signing.key not found — generating RSA signing key...$(COLOR_RESET)"; \
		$(MAKE) --no-print-directory gen-signing-key; \
	fi
	@if [ ! -f secrets/tls.crt ] || [ ! -f secrets/tls.key ]; then \
		echo "$(COLOR_YELLOW)→ TLS certificates not found — generating for Dex HTTPS...$(COLOR_RESET)"; \
		$(MAKE) --no-print-directory setup-tls; \
	fi
	@echo "$(COLOR_YELLOW)Starting local services (Postgres + Redis + glauth + Dex + port proxy)...$(COLOR_RESET)"
	@docker compose up -d --wait postgres redis glauth dex port-proxy
	@echo "$(COLOR_GREEN)✓ Postgres + Redis + glauth + Dex + port proxy ready$(COLOR_RESET)"
	@echo "  Dex OIDC issuer:  https://dex.orbit.local.clearroute.io:5556/dex"
	@echo "  Test user:        dev@orbit.local.clearroute.io / password"
	@echo "  Client ID:        orbit-local  (no secret — public client)"
	@echo ""
	@echo "  Authenticate:     make auth"

.PHONY: dev-down
dev-down: ## Stop Postgres + Redis
	@echo "$(COLOR_YELLOW)Stopping local services...$(COLOR_RESET)"
	@docker compose down
	@echo "$(COLOR_GREEN)✓ Local services stopped$(COLOR_RESET)"

.PHONY: dev-down-clean
dev-down-clean: ## DESTRUCTIVE: stop Postgres + Redis and delete their volumes. Every local database row is lost.
	@echo "$(COLOR_YELLOW)Stopping local services and removing volumes...$(COLOR_RESET)"
	@docker compose down -v
	@$(MAKE) --no-print-directory schema-reset-marker
	@echo "$(COLOR_GREEN)✓ Local services stopped and volumes removed$(COLOR_RESET)"

# ===========================================
# The local Kubernetes cluster (k3d)
# ===========================================

.PHONY: install-tools-cluster
install-tools-cluster: ## Install cluster tooling (k3d, kubectl, helm, helmfile, helm-diff)
	@echo "$(COLOR_YELLOW)Installing cluster tools...$(COLOR_RESET)"
	@bash scripts/cluster/install-tools-cluster.sh
	@echo "$(COLOR_GREEN)✓ Cluster tools installed$(COLOR_RESET)"

# ===========================================
# The three commands you need day to day.
# Each composes the granular recipes below.
# ===========================================

# The schema is applied by the orbit chart's pre-install hook during
# cluster-platform, before any service starts.
.PHONY: up
up: dev-cluster cluster-platform cluster-deploy ## Bring up everything: backing services, k3d cluster, SPIRE + Istio + kora (schema applied by the chart's migrate hook), tenants. Idempotent.
	@echo ""
	@echo "$(COLOR_GREEN)✓ kora is up$(COLOR_RESET)"
	@echo "  Dashboard:   https://orbit.local.clearroute.io"
	@echo "  Backend API: https://api.orbit.local.clearroute.io"
	@echo ""
	@echo "$(COLOR_BLUE)Next: 'make auth' for a token, 'make redeploy SERVICE=<name>' to iterate$(COLOR_RESET)"

.PHONY: down
down: dev-cluster-down dev-down ## Tear down the cluster and the backing services (keeps Postgres and Redis data)

# k3d owns the image registry, so deleting the cluster deletes every built image
# and the next `up` rebuilds them all. Postgres and Redis are Docker Compose
# volumes and are never touched. `make dev-down-clean` is the one that drops data.
.PHONY: reset
reset: dev-cluster-down up ## Recreate the cluster from scratch. Keeps Postgres and Redis data; rebuilds every image.

.PHONY: auth
auth: auth-device-k3d ## Authenticate against the cluster (Device Authorization Grant)

.PHONY: auth-refresh
auth-refresh: auth-refresh-k3d ## Refresh the access token in /tmp/orbit_credentials.json

.PHONY: dev-cluster
dev-cluster: dev-up ## Bring up the local k3d cluster. Starts postgres + Redis + Dex first, then creates the k3d cluster. Run 'make cluster-platform' next.
	@echo "$(COLOR_YELLOW)Bringing up local k3d cluster...$(COLOR_RESET)"
	@bash scripts/cluster/dev-cluster-up.sh

.PHONY: dev-cluster-down
dev-cluster-down: ## Tear down the local k3d cluster
	@echo "$(COLOR_YELLOW)Tearing down local k3d cluster...$(COLOR_RESET)"
	@bash scripts/cluster/dev-cluster-down.sh

# Backend services that are built and pushed during cluster bring-up. Order
# matters only for readability — they're all built serially via redeploy.sh.
# Adding a new service is a one-line edit here plus an entry in redeploy.sh.
REDEPLOY_PLATFORM_SERVICES := \
	identity identity-proxy inference-gateway policy-service policy-gateway \
	egress-gateway agents frontend orbit-mcp tool-gateway orbit-triggers migrate operator \
	session-manager sandbox-mount sandbox-base
REDEPLOY_TENANT_SERVICES := example

# Services with a long-lived orbit-system workload that `cluster-update` rolls
# after the build pass. Excludes identity-proxy (sidecar), sandbox-base
# (on-demand), session-manager (tenant StatefulSet, may not exist yet) and
# operator (helm-managed — upgraded separately so chart/CRD changes land).
REDEPLOY_ROLLOUT_SERVICES := \
	identity inference-gateway policy-service policy-gateway egress-gateway \
	agents frontend orbit-mcp tool-gateway orbit-triggers

# orbit-system deployments we don't build (third-party images) but still restart
# on cluster-update so they re-read chart-managed config on the way back up.
REDEPLOY_RESTART_ONLY := orbit-opa-gateway

OPA_ENVOY_IMAGE := openpolicyagent/opa:1.21.0-envoy-static

# ===========================================
# Image bake (CI / multi-arch publishing)
# ===========================================

.PHONY: docker-bake-build
docker-bake-build: ## Build images via docker buildx bake and load them into the local Docker daemon
	@echo "$(COLOR_YELLOW)Building $(BACKEND_IMAGE_GROUP) from $(DOCKER_BAKE_FILE) with tags $(IMAGE_REPOSITORY_PREFIX)*:$(IMAGE_TAG) [$(DOCKER_BUILD_PLATFORMS)]...$(COLOR_RESET)"
	@REGISTRY=$(IMAGE_REGISTRY) IMAGE_NAMESPACE=$(IMAGE_NAMESPACE) IMAGE_TAG=$(IMAGE_TAG) \
		docker buildx bake -f $(DOCKER_BAKE_FILE) -f versions.hcl \
			--set '*.platform=$(DOCKER_BUILD_PLATFORMS)' \
			--load $(BACKEND_IMAGE_GROUP)
	@echo "$(COLOR_GREEN)✓ Built images with tags $(IMAGE_REPOSITORY_PREFIX)*:$(IMAGE_TAG)$(COLOR_RESET)"

.PHONY: docker-bake-push
docker-bake-push: ## Build and push images via docker buildx bake (defaults to GHCR)
	@echo "$(COLOR_YELLOW)Publishing $(BACKEND_IMAGE_GROUP) from $(DOCKER_BAKE_FILE) to $(IMAGE_REPOSITORY_PREFIX)*:$(IMAGE_TAG) [$(DOCKER_PUSH_PLATFORMS)]...$(COLOR_RESET)"
	@REGISTRY=$(IMAGE_REGISTRY) IMAGE_NAMESPACE=$(IMAGE_NAMESPACE) IMAGE_TAG=$(IMAGE_TAG) \
		docker buildx bake -f $(DOCKER_BAKE_FILE) -f versions.hcl \
			--set '*.platform=$(DOCKER_PUSH_PLATFORMS)' \
			--push $(BACKEND_IMAGE_GROUP)
	@echo "$(COLOR_GREEN)✓ Published images to $(IMAGE_REPOSITORY_PREFIX)*:$(IMAGE_TAG)$(COLOR_RESET)"

.PHONY: docker-pull-third-party
docker-pull-third-party: ## Pull third-party sidecar images and push to local registry (OPA envoy)
	@echo "$(COLOR_YELLOW)Pulling $(OPA_ENVOY_IMAGE)...$(COLOR_RESET)"
	@docker pull $(OPA_ENVOY_IMAGE)
	@docker tag $(OPA_ENVOY_IMAGE) localhost:5001/$(OPA_ENVOY_IMAGE)
	@docker push localhost:5001/$(OPA_ENVOY_IMAGE)
	@echo "$(COLOR_GREEN)✓ localhost:5001/$(OPA_ENVOY_IMAGE)$(COLOR_RESET)"

# ===========================================
# Cluster bring-up + bulk operations
# ===========================================

# Build + push every platform image in BUILD_ONLY mode; used by cluster-platform.
# and cluster-update — anything that needs the local registry seeded but does
# its own restart logic later. Serial by default (parallel builds overload
# low-spec Docker VMs and cascade into mesh/Postgres failures). On machines
# with the headroom, set ORBIT_PARALLEL_BUILDS=1 in .env to switch to a single
# parallel `docker buildx bake` graph — see the local development guide and
# docs/adr/2026-07-21-ci-pipeline-and-local-build-parallelisation.md.
# One prune at the end instead of per-service so cache pruning happens once.
.PHONY: redeploy-platform
redeploy-platform: ## Build + push every platform service to the local registry (no rollout). ORBIT_PARALLEL_BUILDS=1 builds them in parallel.
ifeq ($(ORBIT_PARALLEL_BUILDS),1)
	@$(MAKE) --no-print-directory redeploy-platform-bake
else
	@for svc in $(REDEPLOY_PLATFORM_SERVICES); do \
		bash scripts/cluster/redeploy.sh $$svc --build-only || exit $$?; \
	done
	@docker image prune -f > /dev/null
endif

# Builds only what the registry is missing. `make up` is re-run constantly, and
# rebuilding every image each time fills the k3d node's ephemeral storage, which
# puts the kubelet into DiskPressure and evicts the platform. Use `make redeploy`
# to force a rebuild.
.PHONY: redeploy-platform-missing
redeploy-platform-missing: ## Build + push only the platform images absent from the local registry
	@for svc in $(REDEPLOY_PLATFORM_SERVICES); do \
		img=$$(bash scripts/cluster/redeploy.sh $$svc --print-image); \
		if docker buildx imagetools inspect "localhost:5001/$$img:latest" >/dev/null 2>&1; then \
			echo "$(COLOR_BLUE)ℹ $$svc already in registry, skipping build$(COLOR_RESET)"; \
		else \
			bash scripts/cluster/redeploy.sh $$svc --build-only || exit $$?; \
		fi; \
	done
	@docker image prune -f > /dev/null

.PHONY: redeploy-tenant
redeploy-tenant: ## Build + push every tenant service to the local registry (no rollout)
	@for svc in $(REDEPLOY_TENANT_SERVICES); do \
		bash scripts/cluster/redeploy.sh $$svc --build-only || exit $$?; \
	done
	@docker image prune -f > /dev/null

.PHONY: redeploy-tenant-missing
redeploy-tenant-missing: ## Build + push only the tenant images absent from the local registry
	@for svc in $(REDEPLOY_TENANT_SERVICES); do \
		img=$$(bash scripts/cluster/redeploy.sh $$svc --print-image); \
		if docker buildx imagetools inspect "localhost:5001/$$img:latest" >/dev/null 2>&1; then \
			echo "$(COLOR_BLUE)ℹ $$svc already in registry, skipping build$(COLOR_RESET)"; \
		else \
			bash scripts/cluster/redeploy.sh $$svc --build-only || exit $$?; \
		fi; \
	done
	@docker image prune -f > /dev/null

.PHONY: redeploy-warm
redeploy-warm: redeploy-platform redeploy-tenant ## Pre-build every service to warm BuildKit caches (no rollout) — run once at start of session for fast subsequent redeploys
	@echo "$(COLOR_GREEN)✓ All caches warm — single-service redeploys should now be fast$(COLOR_RESET)"

# redeploy-platform-bake — the ORBIT_PARALLEL_BUILDS=1 path behind
# redeploy-platform. One `docker buildx bake` invocation over the whole
# local-platform group: BuildKit builds every image concurrently and dedups the
# shared mod-download + COPY layers across the graph, which the serial
# `docker build` loop cannot do. Needs a Docker VM with real headroom
# (≥12 CPUs / 24 GiB); on smaller VMs the concurrent build pressure cascades
# into mesh/Postgres failures — keep the serial default there.
# Image names below must match the bake target names in docker-bake.local.hcl,
# which are also the registry image names (service `orbit-mcp` → image
# `orbit-mcp`, not `orbit-orbit-mcp` — don't derive them from
# REDEPLOY_PLATFORM_SERVICES).
BAKE_PLATFORM_IMAGES := \
	orbit-identity orbit-identity-proxy orbit-inference-gateway \
	orbit-policy-service orbit-policy-gateway orbit-egress-gateway \
	orbit-agents orbit-frontend orbit-mcp orbit-tool-gateway orbit-triggers orbit-migrate \
	orbit-operator orbit-session-manager orbit-sandbox-mount kora-sandbox-base

.PHONY: redeploy-platform-bake
redeploy-platform-bake: ## Build + push every platform service in one parallel docker buildx bake graph (the ORBIT_PARALLEL_BUILDS=1 path)
	@GIT_SHA="$$(git rev-parse --short HEAD 2>/dev/null || echo dev)"; \
	if [ -n "$$(git status --porcelain 2>/dev/null)" ]; then GIT_SHA="$${GIT_SHA}-dirty"; fi; \
	echo "$(COLOR_YELLOW)Baking platform images in parallel (GIT_SHA=$$GIT_SHA)...$(COLOR_RESET)"; \
	GIT_SHA="$$GIT_SHA" \
		docker buildx bake \
			-f docker-bake.hcl -f docker-bake.local.hcl -f versions.hcl \
			--load local-platform || exit $$?; \
	if [ -f secrets/mkcert-ca.pem ]; then \
		echo "$(COLOR_YELLOW)Layering mkcert CA into orbit-identity...$(COLOR_RESET)"; \
		printf 'FROM localhost:5001/orbit-identity:latest\nUSER 0\nCOPY mkcert-ca.pem /usr/local/share/ca-certificates/mkcert-ca.crt\nRUN update-ca-certificates\nUSER 65532:65532\n' | \
			docker build -q -t localhost:5001/orbit-identity:latest -f - secrets/ > /dev/null; \
		docker tag localhost:5001/orbit-identity:latest "localhost:5001/orbit-identity:$$GIT_SHA"; \
	fi; \
	echo "$(COLOR_YELLOW)Pushing platform images to localhost:5001 (latest + $$GIT_SHA)...$(COLOR_RESET)"; \
	for img in $(BAKE_PLATFORM_IMAGES); do \
		docker push --quiet "localhost:5001/$$img:latest" > /dev/null && \
		docker push --quiet "localhost:5001/$$img:$$GIT_SHA" > /dev/null && \
		echo "  ✓ $$img" || exit $$?; \
	done
	@docker image prune -f > /dev/null
	@echo "$(COLOR_GREEN)✓ Platform images built and pushed via bake$(COLOR_RESET)"

# Sandbox images make up does not build. They must match the local-sandbox-images
# group in docker-bake.local.hcl.
BAKE_SANDBOX_IMAGES := kora-sandbox-go kora-sandbox-python kora-sandbox-node kora-sandbox-dev

.PHONY: redeploy-sandbox-images
redeploy-sandbox-images: ## Build + push BAKE_SANDBOX_IMAGES (the bundled sandbox images and kora-sandbox-dev) to the local registry
	@GIT_SHA="$$(git rev-parse --short HEAD 2>/dev/null || echo dev)"; \
	if [ -n "$$(git status --porcelain 2>/dev/null)" ]; then GIT_SHA="$${GIT_SHA}-dirty"; fi; \
	GIT_SHA="$$GIT_SHA" docker buildx bake \
		-f docker-bake.hcl -f docker-bake.local.hcl -f versions.hcl \
		--load local-sandbox-images || exit $$?; \
	for img in $(BAKE_SANDBOX_IMAGES); do \
		docker push --quiet "localhost:5001/$$img:latest" > /dev/null && \
		docker push --quiet "localhost:5001/$$img:$$GIT_SHA" > /dev/null && \
		echo "  ✓ $$img" || exit $$?; \
	done
	@docker image prune -f > /dev/null
	@echo "$(COLOR_GREEN)✓ Bundled sandbox images built and pushed$(COLOR_RESET)"

.PHONY: redeploy-tenant-bake
redeploy-tenant-bake: ## (Experimental) Build + push every tenant service via docker buildx bake (serial — one target at a time)
	@GIT_SHA="$$(git rev-parse --short HEAD 2>/dev/null || echo dev)"; \
	if [ -n "$$(git status --porcelain 2>/dev/null)" ]; then GIT_SHA="$${GIT_SHA}-dirty"; fi; \
	echo "$(COLOR_YELLOW)Baking tenant images (serial, GIT_SHA=$$GIT_SHA)...$(COLOR_RESET)"; \
	for tgt in orbit-example; do \
		GIT_SHA="$$GIT_SHA" \
			docker buildx bake \
				-f docker-bake.hcl -f docker-bake.local.hcl -f versions.hcl \
				--load $$tgt || exit $$?; \
	done
	@for svc in $(REDEPLOY_TENANT_SERVICES); do \
		docker push --quiet localhost:5001/orbit-$$svc:latest > /dev/null && \
		echo "  ✓ orbit-$$svc"; \
	done
	@docker image prune -f > /dev/null
	@echo "$(COLOR_GREEN)✓ Tenant images built and pushed via bake$(COLOR_RESET)"

# Re-push every locally-built image to the registry (no build). Recover from a
# Colima/k3d restart without rebuilding anything.
.PHONY: cluster-restore
cluster-restore: ## Re-push locally-built images to the registry after a Colima/k3d restart
	@echo "$(COLOR_YELLOW)Syncing locally-built images to local registry...$(COLOR_RESET)"
	@for svc in $(REDEPLOY_PLATFORM_SERVICES) $(REDEPLOY_TENANT_SERVICES); do \
		if docker image inspect orbit-$$svc:latest > /dev/null 2>&1; then \
			echo "  pushing orbit-$$svc:latest"; \
			docker tag orbit-$$svc:latest localhost:5001/orbit-$$svc:latest; \
			docker push localhost:5001/orbit-$$svc:latest > /dev/null; \
		fi; \
	done
	@if docker image inspect $(OPA_ENVOY_IMAGE) > /dev/null 2>&1; then \
		echo "  pushing $(OPA_ENVOY_IMAGE)"; \
		docker tag $(OPA_ENVOY_IMAGE) localhost:5001/$(OPA_ENVOY_IMAGE); \
		docker push localhost:5001/$(OPA_ENVOY_IMAGE) > /dev/null; \
	fi
	@docker image prune -f > /dev/null
	@echo "$(COLOR_GREEN)✓ Registry synced$(COLOR_RESET)"

.PHONY: cluster-platform
cluster-platform: redeploy-platform-missing docker-pull-third-party ## Install SPIRE, Istio and kora from deploy/reference/helmfile.yaml.gotmpl
	@EXPECTED="$${ORBIT_KUBE_CONTEXT:-k3d-orbit-local}"; \
	 CURRENT="$$(kubectl config current-context 2>/dev/null || echo '<none>')"; \
	 if [ "$$CURRENT" != "$$EXPECTED" ]; then \
	   echo "$(COLOR_RED)✗ kube context is '$$CURRENT', expected '$$EXPECTED'. Switch context or set ORBIT_KUBE_CONTEXT.$(COLOR_RESET)"; exit 1; \
	 fi
	@echo "$(COLOR_YELLOW)Preparing the orbit-system namespace...$(COLOR_RESET)"
	@kubectl create namespace orbit-system --dry-run=client -o yaml | kubectl apply -f - >/dev/null
	@echo "$(COLOR_YELLOW)Creating orbit-system secrets (DB + Redis + signing key)...$(COLOR_RESET)"
	@bash scripts/cluster/create-secrets.sh orbit-system
	@echo "$(COLOR_YELLOW)Creating mkcert CA ConfigMap for Dex TLS verification...$(COLOR_RESET)"
	@$(MAKE) cluster-ca-configmap
	@echo "$(COLOR_YELLOW)Creating TLS secret for the kora ingress gateway...$(COLOR_RESET)"
	@$(MAKE) cluster-tls-secret
	@echo "$(COLOR_YELLOW)Resolving Docker container IPs...$(COLOR_RESET)"
	@bash scripts/cluster/resolve-docker-ips.sh
	@echo "$(COLOR_YELLOW)Applying the reference Helmfile (SPIRE, Istio, kora)...$(COLOR_RESET)"
	@cd deploy/reference && helmfile -e local apply
	@if [ -n "$$BEDROCK_ACCOUNTS" ]; then bash scripts/cluster/refresh-bedrock-creds.sh; fi
	@echo "$(COLOR_GREEN)✓ Platform ready — SPIRE, Istio, and kora services are running$(COLOR_RESET)"
	@echo "  Dashboard:   https://orbit.local.clearroute.io"
	@echo "  Backend API: https://api.orbit.local.clearroute.io"
	@echo "  (HTTP on :8880 redirects to HTTPS)"
	@echo "$(COLOR_YELLOW)Next: 'make cluster-deploy' to register tenants and deploy workloads$(COLOR_RESET)"

.PHONY: cluster-deploy
cluster-deploy: redeploy-tenant-missing ## Register tenants and deploy workloads (builds tenant images only if absent)
	@echo "$(COLOR_YELLOW)Deploying tenant workloads...$(COLOR_RESET)"
	@echo "$(COLOR_YELLOW)Registering tenants (applying OrbitTenant CRs)...$(COLOR_RESET)"
	@kubectl apply -f deploy/local/tenants/
	@echo "  Waiting for tenant namespaces (operator provisioning)..."
	@until kubectl get namespace orbit-tenant-example &>/dev/null; do sleep 3; done
	@echo "  Waiting for the operator to write the tenant registry ConfigMap..."
	@until kubectl get configmap orbit-tenants -n orbit-system -o jsonpath='{.data.tenants\.yaml}' 2>/dev/null | grep -q "id: example"; do sleep 2; done
	@# orbit-identity boots before the tenant exists (cluster-platform runs first) and
	@# builds its OIDC providers at startup. It watches the ConfigMap, but the fsnotify
	@# watcher dies with "too many open files" when the host's inotify limits are low,
	@# leaving federated auth disabled and `make auth` failing with oidc_not_configured.
	@# Restart it unless it has already initialised a provider.
	@if kubectl logs deployment/orbit-identity -n orbit-system -c orbit-identity 2>/dev/null | grep -q "OIDC provider initialized"; then \
		echo "  orbit-identity has the tenant OIDC config"; \
	else \
		echo "$(COLOR_YELLOW)  orbit-identity booted before the tenant existed; restarting it$(COLOR_RESET)"; \
		kubectl rollout restart deployment/orbit-identity -n orbit-system >/dev/null; \
		kubectl rollout status deployment/orbit-identity -n orbit-system --timeout=180s; \
		if ! kubectl logs deployment/orbit-identity -n orbit-system -c orbit-identity 2>/dev/null | grep -q "OIDC provider initialized"; then \
			echo "$(COLOR_RED)✗ orbit-identity still has no OIDC provider. 'make auth' will fail with oidc_not_configured.$(COLOR_RESET)"; \
			echo "  Check: kubectl logs deployment/orbit-identity -n orbit-system -c orbit-identity | grep -i tenant"; \
			exit 1; \
		fi; \
	fi
	@echo "$(COLOR_YELLOW)Creating tenant secrets...$(COLOR_RESET)"
	@bash scripts/cluster/create-secrets.sh orbit-tenant-example
	@echo "$(COLOR_YELLOW)Registering tenant connections...$(COLOR_RESET)"
	@kubectl get secret orbit-local-token -n orbit-tenant-example &>/dev/null && kubectl apply -f deploy/local/connections/kubernetes.yaml || echo "  (no orbit-local-token; run 'make cluster-k8s-connection' to register the local cluster as a connection)"
	@if [ -f secrets/orbit-github-app.pem ]; then \
		kubectl create secret generic github-app-key -n orbit-tenant-example --from-file=key.pem=secrets/orbit-github-app.pem --dry-run=client -o yaml | kubectl apply -f - ; \
		kubectl apply -f deploy/local/connections/github.yaml ; \
		echo "  ✓ GitHub connection registered from secrets/orbit-github-app.pem"; \
	else \
		echo "  (no secrets/orbit-github-app.pem — skipping GitHub connection; it is optional)"; \
	fi
	@echo "$(COLOR_YELLOW)Applying tenant workload fixtures...$(COLOR_RESET)"
	@kubectl apply -f deploy/local/fixtures/
	@echo "$(COLOR_YELLOW)Waiting for example workload to be ready...$(COLOR_RESET)"
	@until kubectl get deployment orbit-example -n orbit-tenant-example &>/dev/null; do sleep 3; done
	@kubectl rollout status deployment/orbit-example -n orbit-tenant-example --timeout=180s
	@echo "$(COLOR_GREEN)✓ Tenant workloads deployed$(COLOR_RESET)"

.PHONY: cluster-update
cluster-update: redeploy-platform redeploy-tenant ## Rebuild every service image and restart deployments
	@echo "$(COLOR_YELLOW)Re-applying the kora releases (picks up CRD + template changes)...$(COLOR_RESET)"
	@cd deploy/reference && helmfile -e local apply --selector name=orbit-crds && helmfile -e local apply --selector name=orbit
	@yq -i ".migrate.sourceHash = \"$$(bash scripts/cluster/migrations-hash.sh)\"" deploy/reference/environments/local.generated.yaml
	@bash scripts/cluster/redeploy.sh operator --no-build
	@echo "$(COLOR_YELLOW)Rolling platform services onto the images just built...$(COLOR_RESET)"
	@# `kubectl rollout restart` is NOT enough: redeploy.sh pins workloads to an
	@# image digest, so a restart faithfully re-pulls the *old* digest. Re-pinning
	@# via redeploy.sh --no-build is what actually advances the image.
	@for svc in $(REDEPLOY_ROLLOUT_SERVICES); do \
		bash scripts/cluster/redeploy.sh $$svc --no-build || exit $$?; \
	done
	@echo "$(COLOR_YELLOW)Restarting non-built platform deployments...$(COLOR_RESET)"
	@for dep in $(REDEPLOY_RESTART_ONLY); do \
		kubectl get deployment $$dep -n orbit-system >/dev/null 2>&1 || continue; \
		kubectl rollout restart deployment/$$dep -n orbit-system; \
		kubectl rollout status deployment/$$dep -n orbit-system --timeout=120s; \
	done
	@echo "$(COLOR_YELLOW)Rolling tenant workloads...$(COLOR_RESET)"
	@for svc in $(REDEPLOY_TENANT_SERVICES); do \
		bash scripts/cluster/redeploy.sh $$svc --no-build || exit $$?; \
	done
	@echo "$(COLOR_GREEN)✓ All services updated with latest images$(COLOR_RESET)"

.PHONY: cluster-k8s-connection
cluster-k8s-connection: ## Register the local k3d cluster as a Kubernetes connection for the example tenant
	@bash scripts/cluster/register-k8s-connection.sh

.PHONY: cluster-bedrock-creds
cluster-bedrock-creds: ## Register Bedrock InferenceProviders from your AWS SSO session (AWS_PROFILE and BEDROCK_* in .env)
	@bash scripts/cluster/refresh-bedrock-creds.sh

# ===========================================
# Redeploy — single dispatcher for "I changed one service, push it"
# ===========================================
#
# All targets below funnel through scripts/cluster/redeploy.sh, which holds the
# per-service registry (Dockerfile, build context, build args, namespace,
# workload kind/name, post-build hooks). Adding a new service is a single edit
# in that script — Makefile just exposes shortcuts.
#
# Usage:
#   make redeploy SERVICE=identity                       # build + push + rollout
#   make redeploy SERVICE=session-manager TENANT=example # tenant-scoped
#   make redeploy SERVICE=sandbox-base BUILD_ONLY=1      # build + push only
#   make redeploy SERVICE=identity NO_BUILD=1            # rollout only
#
# Or use the per-service shortcut targets (redeploy-identity, redeploy-frontend, …).

REDEPLOY_FLAGS := \
	$(if $(TENANT),--tenant $(TENANT)) \
	$(if $(SLUG),--slug $(SLUG)) \
	$(if $(BUILD_ONLY),--build-only) \
	$(if $(NO_BUILD),--no-build)

.PHONY: redeploy
redeploy: ## Rebuild and roll every service. SERVICE=<name> narrows it to one (see: make redeploy-list)
	@# A single-service redeploy applies pending migrations first. The full
	@# redeploy builds migrate and re-applies the release in cluster-update.
	@if [ -n "$(SERVICE)" ] && [ "$(SERVICE)" != "migrate" ]; then \
		$(MAKE) --no-print-directory redeploy-migrate-if-changed; \
	fi
	@if [ -n "$(SERVICE)" ]; then \
		bash scripts/cluster/redeploy.sh $(SERVICE) $(REDEPLOY_FLAGS); \
	else \
		$(MAKE) --no-print-directory cluster-update; \
	fi

.PHONY: redeploy-list
redeploy-list: ## List every service known to `make redeploy`
	@bash scripts/cluster/redeploy.sh --help 2>&1 | sed -n '/^Services:/,/^Flags:/p' | sed '$$d'

.PHONY: redeploy-status
redeploy-status: ## Show drift between cluster-deployed images and the local registry
	@bash scripts/cluster/redeploy-status.sh

.PHONY: redeploy-identity
redeploy-identity: ## Redeploy identity (rebuilds with mkcert CA layer for Dex TLS)
	@bash scripts/cluster/redeploy.sh identity $(REDEPLOY_FLAGS)

.PHONY: redeploy-identity-proxy
redeploy-identity-proxy: ## Redeploy identity-proxy sidecar (deletes injected pods so the operator re-injects)
	@bash scripts/cluster/redeploy.sh identity-proxy $(REDEPLOY_FLAGS)

.PHONY: redeploy-inference-gateway
redeploy-inference-gateway: ## Redeploy the inference gateway
	@bash scripts/cluster/redeploy.sh inference-gateway $(REDEPLOY_FLAGS)

.PHONY: redeploy-policy-service
redeploy-policy-service: ## Redeploy the policy service (PDP/PAP)
	@bash scripts/cluster/redeploy.sh policy-service $(REDEPLOY_FLAGS)

.PHONY: redeploy-policy-gateway
redeploy-policy-gateway: ## Redeploy the policy gateway (PEP)
	@bash scripts/cluster/redeploy.sh policy-gateway $(REDEPLOY_FLAGS)

.PHONY: redeploy-egress-gateway
redeploy-egress-gateway: ## Redeploy the egress gateway (per-tenant credential broker)
	@bash scripts/cluster/redeploy.sh egress-gateway $(REDEPLOY_FLAGS)

.PHONY: redeploy-agents
redeploy-agents: ## Redeploy orbit-agents (agent control plane)
	@bash scripts/cluster/redeploy.sh agents $(REDEPLOY_FLAGS)

.PHONY: redeploy-frontend
redeploy-frontend: ## Redeploy the frontend
	@bash scripts/cluster/redeploy.sh frontend $(REDEPLOY_FLAGS)

.PHONY: redeploy-tool-gateway
redeploy-tool-gateway: ## Redeploy the tool gateway (also rolls the publisher — same image)
	@bash scripts/cluster/redeploy.sh tool-gateway $(REDEPLOY_FLAGS)

.PHONY: redeploy-triggers
redeploy-triggers: ## Redeploy orbit-triggers (webhook ingestion, management API, scheduler)
	@bash scripts/cluster/redeploy.sh orbit-triggers $(REDEPLOY_FLAGS)

.PHONY: redeploy-operator
redeploy-operator: ## Redeploy the orbit-operator (tenant lifecycle, webhooks, preflight)
	@bash scripts/cluster/redeploy.sh operator $(REDEPLOY_FLAGS)

.PHONY: redeploy-example
redeploy-example: ## Redeploy the example tenant workload (default tenant=example, override with TENANT=…)
	@bash scripts/cluster/redeploy.sh example $(REDEPLOY_FLAGS)

.PHONY: redeploy-session-manager
redeploy-session-manager: ## Redeploy session-manager (statefulset, default tenant=example, override with TENANT=… SLUG=…)
	@bash scripts/cluster/redeploy.sh session-manager $(REDEPLOY_FLAGS)

.PHONY: redeploy-sandbox-mount
redeploy-sandbox-mount: ## Redeploy the sandbox-mount node agent (rolled by re-applying the orbit release)
	@bash scripts/cluster/redeploy.sh sandbox-mount $(REDEPLOY_FLAGS)

.PHONY: redeploy-sandbox-base
redeploy-sandbox-base: ## Build + push the sandbox base image (no rollout; picked up by the next sandbox)
	@bash scripts/cluster/redeploy.sh sandbox-base $(REDEPLOY_FLAGS)

.PHONY: prune
prune: ## Prune dangling Docker images and cap the BuildKit cache at 5 GB
	@echo "$(COLOR_YELLOW)Pruning dangling images...$(COLOR_RESET)"
	@docker image prune -f
	@echo "$(COLOR_YELLOW)Pruning BuildKit cache (keeping ≤5 GB)...$(COLOR_RESET)"
	@docker buildx prune -f --keep-storage 5GB
	@echo "$(COLOR_GREEN)✓ Pruned$(COLOR_RESET)"

# ===========================================
# Development Workflow
# ===========================================

.PHONY: build-backend
build-backend: proto-gen ## Build every cmd/ binary to .bin (runs proto-gen first)
	@echo "$(COLOR_YELLOW)Building service binaries...$(COLOR_RESET)"
	@mkdir -p $(BINARY_DIR)
	@for dir in $(BACKEND_DIR)/cmd/*/; do \
		name=$$(basename "$$dir"); \
		[ -f "$$dir/main.go" ] || continue; \
		(cd $(BACKEND_DIR) && $(GOBUILD) -o "../$(BINARY_DIR)/orbit-$${name#orbit-}" "./cmd/$$name") || exit 1; \
	done

# ===========================================
# Testing & Quality
# ===========================================

.PHONY: test-integration
test-integration: auth-refresh-k3d ## Live-cluster authz tests. Needs a full k3d cluster (dev-cluster + cluster-platform + cluster-deploy + auth-device-k3d). Not run by CI or `make check`.
	@echo "$(COLOR_YELLOW)Running integration tests...$(COLOR_RESET)"
	@kubectl port-forward svc/orbit-policy-service -n orbit-system 8083:80 >/tmp/orbit-pf-policy.log 2>&1 & \
		PF_PID=$$!; \
		sleep 2; \
		cd $(BACKEND_DIR) && $(GOTEST) -v -race -timeout=5m -tags=integration ./...; \
		STATUS=$$?; \
		kill $$PF_PID 2>/dev/null || true; \
		if [ $$STATUS -eq 0 ]; then echo "$(COLOR_GREEN)✓ Integration tests passed$(COLOR_RESET)"; fi; \
		exit $$STATUS

.PHONY: test-postgres
test-postgres: ## Postgres-backed repository tests against the local Postgres. Needs the compose Postgres up. Not run by CI or `make check`.
	@$(MIGRATE) up
	@echo "$(COLOR_YELLOW)Running Postgres-backed repository tests...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && ORBIT_TEST_DB_URL="$(DB_URL)" $(GOTEST) -race -timeout=5m ./... -run Postgres

.PHONY: test
test: ## Run unit tests with coverage (no cluster required)
	@echo "$(COLOR_YELLOW)Running tests...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOTEST) -race -timeout=5m -coverprofile=coverage.out -covermode=atomic ./...
	@echo ""
	@echo "$(COLOR_BOLD)Total coverage:$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOCMD) tool cover -func=coverage.out | tail -n 1

.PHONY: test-verbose
test-verbose: ## Run tests with verbose output
	@echo "$(COLOR_YELLOW)Running tests (verbose)...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOTEST) -v -race -timeout=5m -coverprofile=coverage.out -covermode=atomic ./...
	@echo ""
	@echo "$(COLOR_BOLD)Coverage report:$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOCMD) tool cover -func=coverage.out

.PHONY: test-quiet
test-quiet: ## Run tests with minimal output (CI/agent-friendly)
	@echo "$(COLOR_YELLOW)Running tests (quiet mode)...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOTEST) -race -timeout=5m -coverprofile=coverage.out -covermode=atomic ./... 2>&1 | \
		grep -E '(PASS|FAIL|coverage:|^ok|^FAIL)' || true
	@echo ""
	@cd $(BACKEND_DIR) && $(GOCMD) tool cover -func=coverage.out | tail -n 1

.PHONY: test-coverage
test-coverage: test ## Run tests and generate HTML coverage report
	@cd $(BACKEND_DIR) && $(GOCMD) tool cover -html=coverage.out -o coverage.html
	@echo "$(COLOR_GREEN)✓ Coverage report: backend/coverage.html$(COLOR_RESET)"

.PHONY: docs-check
docs-check: ## Check docs for drift (broken links, missing index entries, dead make targets, stale binary table, hardcoded counts)
	@bash scripts/docs/check-docs.sh
	@node tools/diagrams/check.mjs

.PHONY: diagrams
diagrams: ## Render architecture diagrams from Excalidraw sources (docs/diagrams/*.excalidraw -> *.svg)
	@cd tools/diagrams && node export.mjs

.PHONY: secrets
secrets: ## Scan for secrets and leaked credentials (gitleaks)
	@echo "$(COLOR_YELLOW)Scanning for secrets...$(COLOR_RESET)"
	@if command -v gitleaks > /dev/null; then \
		gitleaks detect --source . --config .gitleaks.toml --redact; \
		echo "$(COLOR_GREEN)✓ No secrets detected$(COLOR_RESET)"; \
	else \
		echo "$(COLOR_YELLOW)gitleaks not installed. Run 'make install-tools'$(COLOR_RESET)"; \
		exit 1; \
	fi

.PHONY: lint
lint: ## Run golangci-lint
	@echo "$(COLOR_YELLOW)Running linters...$(COLOR_RESET)"
	@if command -v golangci-lint > /dev/null; then \
		if cd $(BACKEND_DIR) && $(GOLINT) run ./...; then \
			echo "$(COLOR_GREEN)✓ Linting passed$(COLOR_RESET)"; \
		else \
			echo "$(COLOR_RESET)"; \
			exit 1; \
		fi \
	else \
		echo "$(COLOR_YELLOW)golangci-lint not installed. Run 'make install-tools'$(COLOR_RESET)"; \
		exit 1; \
	fi

.PHONY: fmt
fmt: ## Format code with gofmt
	@echo "$(COLOR_YELLOW)Formatting code...$(COLOR_RESET)"
	@$(GOFMT) -s -w $(BACKEND_DIR)
	@cd $(BACKEND_DIR) && $(GOCMD) fmt ./...
	@echo "$(COLOR_GREEN)✓ Code formatted$(COLOR_RESET)"

.PHONY: vet
vet: ## Run go vet
	@echo "$(COLOR_YELLOW)Running go vet...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOCMD) vet ./...
	@echo "$(COLOR_GREEN)✓ Vet passed$(COLOR_RESET)"

.PHONY: fix
fix: ## Run go fix
	@echo "$(COLOR_YELLOW)Running go fix...$(COLOR_RESET)"
	@cd $(BACKEND_DIR) && $(GOCMD) fix ./...
	@echo "$(COLOR_GREEN)✓ Fixes applied$(COLOR_RESET)"

# ===========================================
# Frontend
# ===========================================

.PHONY: frontend-install
frontend-install: ## Install frontend dependencies (enforces nvm + Node LTS + pnpm, idempotent)
	@echo "$(COLOR_YELLOW)Setting up frontend environment...$(COLOR_RESET)"
	@# ── 1. Enforce nvm ────────────────────────────────────────────────────────
	@export NVM_DIR="$${NVM_DIR:-$$HOME/.nvm}"; \
	export COREPACK_ENABLE_DOWNLOAD_PROMPT=0; \
	if [ ! -f "$$NVM_DIR/nvm.sh" ]; then \
		echo "$(COLOR_RED)✗ nvm not found at $$NVM_DIR$(COLOR_RESET)"; \
		echo "  Install nvm: https://github.com/nvm-sh/nvm"; \
		exit 1; \
	fi; \
	. "$$NVM_DIR/nvm.sh"; \
	echo "  Ensuring Node LTS via nvm (skipped if already installed)..."; \
	nvm install $(NODE_VERSION); \
	nvm use $(NODE_VERSION); \
	echo "  Enabling Corepack..."; \
	corepack enable; \
	if pnpm --version 2>/dev/null | grep -q "^$(PNPM_VERSION)$$"; then \
		echo "  pnpm $(PNPM_VERSION) already installed — skipping"; \
	else \
		echo "  Installing pnpm $(PNPM_VERSION) via Corepack..."; \
		corepack install -g pnpm@$(PNPM_VERSION); \
	fi; \
	cd $(FRONTEND_DIR) && pnpm install $(if $(CI),--frozen-lockfile,)
	@echo "$(COLOR_GREEN)✓ Frontend dependencies installed$(COLOR_RESET)"

.PHONY: frontend-build
frontend-build: ## Build the frontend for production
	@echo "$(COLOR_YELLOW)Building frontend...$(COLOR_RESET)"
	@if [ ! -f .env ]; then \
		echo "$(COLOR_RED)✗ .env not found. Run 'make setup' (or 'make env') first.$(COLOR_RESET)"; \
		exit 1; \
	fi
	@set -a && . ./.env && set +a && cd $(FRONTEND_DIR) && pnpm build
	@echo "$(COLOR_GREEN)✓ Frontend built$(COLOR_RESET)"

.PHONY: frontend-lint
frontend-lint: ## Lint the frontend (eslint)
	@echo "$(COLOR_YELLOW)Linting frontend...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm lint
	@echo "$(COLOR_GREEN)✓ Frontend lint passed$(COLOR_RESET)"

.PHONY: frontend-type-check
frontend-type-check: ## Type-check the frontend (tsc --noEmit)
	@echo "$(COLOR_YELLOW)Type-checking frontend...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm type-check
	@echo "$(COLOR_GREEN)✓ Frontend type-check passed$(COLOR_RESET)"

.PHONY: frontend-fmt
frontend-fmt: ## Format frontend code (prettier --write locally, --check in CI)
	@echo "$(COLOR_YELLOW)Formatting frontend...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm exec prettier $(if $(CI),--check,--write) .
	@echo "$(COLOR_GREEN)✓ Frontend formatting OK$(COLOR_RESET)"

.PHONY: frontend-test-unit
frontend-test-unit: ## Run frontend unit tests (Hades first, then app)
	@echo "$(COLOR_YELLOW)Running frontend unit tests...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm --filter @runkora/hades run test:unit
	@cd $(FRONTEND_DIR) && pnpm run test:unit
	@echo "$(COLOR_GREEN)✓ Frontend unit tests passed$(COLOR_RESET)"

.PHONY: frontend-test-integration
frontend-test-integration: ## Run frontend integration tests (MSW + jsdom)
	@echo "$(COLOR_YELLOW)Running frontend integration tests...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm run test:integration
	@echo "$(COLOR_GREEN)✓ Frontend integration tests passed$(COLOR_RESET)"

.PHONY: frontend-test-hades
frontend-test-hades: ## Run Hades component unit tests in isolation (happy-dom)
	@echo "$(COLOR_YELLOW)Running Hades unit tests...$(COLOR_RESET)"
	@cd $(FRONTEND_DIR) && pnpm --filter @runkora/hades run test:unit
	@echo "$(COLOR_GREEN)✓ Hades unit tests passed$(COLOR_RESET)"

