#!/usr/bin/env bash
# =============================================================================
# versions.env: single source of truth for pinned cluster tool versions
#
# install-tools-cluster.sh, the Makefile tool check, the k8s-toolchain CI
# action and the release's compatibility statement source this file. When
# bumping a version, change it here only. SPIRE and Istio chart versions live
# in deploy/reference/environments/*.yaml.
# =============================================================================

K3D_VERSION="v5.8.3"
# kubectl supports one minor of skew from the API server. Keep it on the k3s
# minor in infrastructure/bootstrap/k3d-config.yaml.
KUBECTL_VERSION="v1.36.5"
HELM_VERSION="v4.3.0"
# helm-diff makes `helmfile apply` a no-op on an unchanged environment.
HELMFILE_VERSION="v1.8.1"
HELM_DIFF_VERSION="v3.15.15"
# yq edits deploy/reference/environments/local.generated.yaml during cluster bring-up.
YQ_VERSION="v4.54.1"
# kubeconform validates rendered manifests in charts CI.
KUBECONFORM_VERSION="v0.8.0"
