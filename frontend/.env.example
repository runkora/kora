# ---------------------------------------------------------------
# Environment variable reference — copy to .env.local and fill in.
# ---------------------------------------------------------------

# URL of the Go control plane API (server-side BFF only)
ORBIT_API_URL=http://localhost:6069/api/v1

# Internal BFF session secret (min 32 chars)
# Generate with: openssl rand -hex 32
BFF_SESSION_SECRET=

# Public base URL of this Next.js app
NEXT_PUBLIC_APP_URL=http://localhost:3000
