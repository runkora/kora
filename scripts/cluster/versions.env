#!/usr/bin/env bash
# =============================================================================
# versions.env: single source of truth for all pinned tool and image versions
#
# Both dev-cluster-up.sh and install-tools-cluster.sh source this file.
# When bumping a version, change it here only.
# SPIRE_SERVER/AGENT/CONTROLLER_MANAGER_VERSION are informational: the Helm chart
# (spiffe/spire at SPIRE_CHART_VERSION) pins these internally via its appVersion.
# They are used only for pre-pulling images into the local Docker cache before
# cluster creation (see PREFETCH_IMAGES in dev-cluster-up.sh).
# =============================================================================

# ── Cluster tooling ───────────────────────────────────────────────────────────
K3D_VERSION="v5.9.0"
KUBECTL_VERSION="v1.33.13"
HELM_VERSION="v4.2.3"
# helm-diff makes `helmfile apply` a no-op on an unchanged environment.
HELMFILE_VERSION="v1.7.4"
HELM_DIFF_VERSION="v3.15.12"
# yq edits deploy/reference/environments/local.generated.yaml during cluster bring-up.
YQ_VERSION="v4.44.3"
# kubeconform validates rendered manifests in charts CI.
KUBECONFORM_VERSION="v0.6.7"

# ── Helm chart versions ───────────────────────────────────────────────────────
# Informational only, to pre-pull images; the reference install pins these
# in deploy/reference/environments/*.yaml.
SPIRE_CRDS_CHART_VERSION="0.5.0"
SPIRE_CHART_VERSION="0.28.3"
ISTIO_CHART_VERSION="1.29.1"

# ── SPIRE image versions (informational, Helm chart pins these internally) ───
# These must match the appVersion bundled in SPIRE_CHART_VERSION above.
SPIRE_SERVER_VERSION="1.9.6"
SPIRE_AGENT_VERSION="1.9.6"
SPIRE_CONTROLLER_MANAGER_VERSION="0.6.4"

# ── Supporting images ─────────────────────────────────────────────────────────
BUSYBOX_VERSION="1.36.1"
