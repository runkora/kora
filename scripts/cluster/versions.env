#!/usr/bin/env bash
# =============================================================================
# versions.env — Single source of truth for all pinned tool and image versions
#
# Both dev-cluster-up.sh and install-tools-cluster.sh source this file.
# When bumping a version, change it here only.
# SPIRE_SERVER/AGENT/CONTROLLER_MANAGER_VERSION are informational — the Helm chart
# (spiffe/spire at SPIRE_CHART_VERSION) pins these internally via its appVersion.
# They are used only for pre-pulling images into the local Docker cache before
# cluster creation (see PREFETCH_IMAGES in dev-cluster-up.sh).
# =============================================================================

# ── Cluster tooling ───────────────────────────────────────────────────────────
K3D_VERSION="v5.6.3"
KUBECTL_VERSION="v1.29.4"
ISTIO_VERSION="1.21.2"
HELM_VERSION="v3.14.4"
KUSTOMIZE_VERSION="v5.3.0"

# ── Helm chart versions ───────────────────────────────────────────────────────
# spiffe/spire-crds must be installed before spiffe/spire (CRDs must exist first)
# spire-crds 0.3.0 provides: clusterspiffeids, clusterfederatedtrustdomains, clusterstaticentries
SPIRE_CRDS_CHART_VERSION="0.3.0"
# spiffe/spire umbrella chart 0.20.0 = SPIRE app version 1.9.4
# (0.21.0 = 1.9.6 — do NOT use; 0.20.0 is the correct pin for 1.9.4)
SPIRE_CHART_VERSION="0.20.0"
# istio/base + istio/istiod — chart version matches the app version for Istio
ISTIO_CHART_VERSION="1.21.2"

# ── SPIRE image versions (informational — Helm chart pins these internally) ───
# These must match the appVersion for SPIRE_CHART_VERSION above.
SPIRE_SERVER_VERSION="1.9.4"
SPIRE_AGENT_VERSION="1.9.4"
SPIRE_CONTROLLER_MANAGER_VERSION="0.6.3"

# ── Supporting images ─────────────────────────────────────────────────────────
BUSYBOX_VERSION="1.36.1"
