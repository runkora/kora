# syntax=docker/dockerfile:1
#
# kora sandbox base image (kora-sandbox-base): the sandbox-exec gRPC server, the
# general command-line tools, Go and Python. Platform teams build their sandbox
# images FROM it. See docs/adr/2026-10-03-sandbox-environments.md.

# =============================================================================
# VERSION CONFIGURATION
# =============================================================================
ARG BUN_VERSION=1.3.9
ARG GO_VERSION=1.26.0
ARG RUST_VERSION=1.83.0
ARG JAVA_VERSION=21
ARG DOTNET_VERSION=8.0
ARG RUBY_VERSION=3.3
# kubectl only supports one minor version of skew from the API server, so pin
# this to the minor of the cluster a `kubernetes` connection points at.
ARG KUBECTL_VERSION=1.36.5
ARG KUSTOMIZE_VERSION=5.8.1

# =============================================================================
# INSTALL FLAGS
# =============================================================================
ARG INSTALL_BUN=false
ARG INSTALL_RUST=false
ARG INSTALL_GO=true
ARG INSTALL_JAVA=false
ARG INSTALL_DOTNET=false
ARG INSTALL_RUBY=false
ARG INSTALL_BROWSERS=false
ARG INSTALL_KUBECTL=true
ARG INSTALL_KUSTOMIZE=true

# ── Build sandbox-exec binary ─────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

WORKDIR /app

ENV GOPRIVATE=github.com/clear-route/*
ENV GONOSUMDB=github.com/clear-route/*
ENV GONOPROXY=github.com/clear-route/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY . .

# The builder runs on the native build platform and Go cross-compiles for the
# target, so multi-arch builds never compile under QEMU emulation.
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /sandbox-exec ./cmd/sandbox-exec

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

# The operator accepts a sandbox image only when it carries this label. It names
# the base version the image was built on.
ARG SANDBOX_BASE_VERSION=dev
LABEL io.orbit.sandbox.base=$SANDBOX_BASE_VERSION

ARG BUN_VERSION
ARG GO_VERSION
ARG RUST_VERSION
ARG JAVA_VERSION
ARG DOTNET_VERSION
ARG RUBY_VERSION
ARG KUBECTL_VERSION
ARG KUSTOMIZE_VERSION
ARG INSTALL_BUN
ARG INSTALL_RUST
ARG INSTALL_GO
ARG INSTALL_JAVA
ARG INSTALL_DOTNET
ARG INSTALL_RUBY
ARG INSTALL_BROWSERS
ARG INSTALL_KUBECTL
ARG INSTALL_KUSTOMIZE

# Base dependencies + the universal developer CLIs an agent needs for real
# engineering work (clone, search, build native deps, fetch, slice JSON). Heavier
# language runtimes stay build-arg-gated below. fd ships as `fdfind` on Debian
# (binary-name clash); symlink it to the conventional `fd`.
RUN apt-get update && apt-get install -y \
      curl wget ca-certificates build-essential git \
      jq ripgrep fd-find \
 && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh) — not in Debian main; installed from the official apt repo.
RUN mkdir -p -m 755 /etc/apt/keyrings \
 && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y gh \
 && rm -rf /var/lib/apt/lists/*

# Python (always installed), with PyYAML for the YAML scripting agents reach for.
RUN apt-get update && apt-get install -y \
      python3 python3-pip python3-venv python3-yaml && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/* && \
    python --version

# uv + uvx
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh && \
    uv --version

# Bun
RUN if [ "$INSTALL_BUN" = "true" ]; then \
      apt-get update && apt-get install -y unzip && \
      rm -rf /var/lib/apt/lists/* && \
      dpkgArch="$(dpkg --print-architecture)"; \
      case "${dpkgArch##*-}" in \
        amd64) ARCH='x64';; \
        arm64) ARCH='aarch64';; \
      esac; \
      curl --proto '=https' --tlsv1.2 -fsSLO "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-$ARCH.zip" && \
      unzip bun-linux-$ARCH.zip -d /tmp/bun && \
      mv /tmp/bun/bun-linux-$ARCH/bun /usr/local/bin/bun && \
      chmod +x /usr/local/bin/bun && \
      rm -rf bun-linux-$ARCH.zip /tmp/bun && \
      bun --version ; \
    fi

# Rust
RUN if [ "$INSTALL_RUST" = "true" ]; then \
      echo 'export RUSTUP_HOME=/usr/local/rustup' >> /etc/profile.d/rust.sh && \
      echo 'export CARGO_HOME=/usr/local/cargo' >> /etc/profile.d/rust.sh && \
      echo 'export PATH=/usr/local/cargo/bin:$PATH' >> /etc/profile.d/rust.sh && \
      . /etc/profile.d/rust.sh && \
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain $RUST_VERSION && \
      chmod -R a+w $RUSTUP_HOME $CARGO_HOME && \
      rustc --version && \
      cargo --version ; \
    fi

# Go
RUN if [ "$INSTALL_GO" = "true" ]; then \
      set -eux; \
      dpkgArch="$(dpkg --print-architecture)"; ARCH="${dpkgArch##*-}"; \
      curl --proto '=https' --tlsv1.2 -fsSLO https://go.dev/dl/go${GO_VERSION}.linux-$ARCH.tar.gz && \
      tar -C /usr/local -xzf go${GO_VERSION}.linux-$ARCH.tar.gz && \
      rm go${GO_VERSION}.linux-$ARCH.tar.gz && \
      echo 'export PATH=/usr/local/go/bin:$PATH' >> /etc/profile.d/go.sh && \
      . /etc/profile.d/go.sh && \
      go version ; \
    fi
# sandbox-exec runs commands in a non-login shell, which never reads profile.d.
# Rust's paths are set here too so an INSTALL_RUST build works the same way.
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/go/bin:/usr/local/cargo/bin:$PATH

# Java (Eclipse Temurin) + Maven + Gradle
RUN if [ "$INSTALL_JAVA" = "true" ]; then \
      apt-get update && apt-get install -y wget apt-transport-https gnupg && \
      wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
      echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(. /etc/os-release && echo $VERSION_CODENAME) main" > /etc/apt/sources.list.d/adoptium.list && \
      apt-get update && apt-get install -y temurin-${JAVA_VERSION}-jdk maven gradle && \
      rm -rf /var/lib/apt/lists/* && \
      java --version && \
      mvn --version && \
      gradle --version ; \
    fi

# .NET SDK
RUN if [ "$INSTALL_DOTNET" = "true" ]; then \
      apt-get update && apt-get install -y wget libicu-dev && \
      dpkgArch="$(dpkg --print-architecture)"; \
      case "${dpkgArch}" in \
        amd64) DOTNET_ARCH='x64';; \
        arm64) DOTNET_ARCH='arm64';; \
      esac; \
      wget https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh && \
      chmod +x /tmp/dotnet-install.sh && \
      /tmp/dotnet-install.sh --channel ${DOTNET_VERSION} --install-dir /usr/share/dotnet --architecture $DOTNET_ARCH && \
      ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet && \
      rm /tmp/dotnet-install.sh && \
      rm -rf /var/lib/apt/lists/* && \
      dotnet --version ; \
    fi

# Ruby + Bundler
RUN if [ "$INSTALL_RUBY" = "true" ]; then \
      apt-get update && apt-get install -y ruby-full && \
      gem install bundler && \
      rm -rf /var/lib/apt/lists/* && \
      ruby --version && \
      bundler --version ; \
    fi

# Browsers (Chromium + Firefox)
RUN if [ "$INSTALL_BROWSERS" = "true" ]; then \
      apt-get update && apt-get install -y \
        wget \
        libdbus-glib-1-2 \
        --no-install-recommends chromium && \
      ln -sf /usr/bin/chromium /usr/local/bin/google-chrome && \
      dpkgArch="$(dpkg --print-architecture)"; \
      case "$dpkgArch" in \
        amd64) FF_OS='linux64';; \
        arm64) FF_OS='linux64-aarch64';; \
      esac && \
      wget -q -O firefox.tar.xz "https://download.mozilla.org/?product=firefox-latest&os=$FF_OS&lang=en-US" && \
      tar -xf firefox.tar.xz -C /opt && \
      ln -s /opt/firefox/firefox /usr/local/bin/firefox && \
      rm firefox.tar.xz && \
      rm -rf /var/lib/apt/lists/* && \
      echo "Chromium version:" && chromium --version && \
      echo "Firefox version:" && firefox --version ; \
    fi

# kubectl — for agents granted a `kubernetes` connection.
#
# The agent runs plain `kubectl get pods`. sandbox-exec writes $HOME/.kube/config
# at startup from ORBIT_KUBE_CLUSTERS (internal/agents/sandbox/kubeconfig), so
# there is no server URL to pass, no kubeconfig to author and no token to find.
#
# No credential ever reaches the sandbox. The rendered kubeconfig carries a
# self-describing placeholder bearer; transparent egress intercepts the TLS and
# the gateway's credential broker overwrites the Authorization header with the
# connection's ServiceAccount token on the re-originated leg. The target
# cluster's own RBAC is the backstop. See docs/adr/2026-07-06-kubernetes-
# connection-bearer-adapter-and-gateway-ca-trust.md.
#
# The placeholder is required, not cosmetic: kubectl's clientcmd refuses to send
# an unauthenticated request. Given no auth info — even an explicit empty
# `user: {}` — it prompts on stdin for a username and never opens a connection.
# `kubectl --server=<host>` alone therefore does NOT work here.
#
# The gateway's CA is already trusted: the agent pod mounts the tenant CA over
# the OS trust bundle (internal/agents/k8s.go), which kubectl honours as a Go
# binary — so the kubeconfig sets no certificate-authority, and kubectl must
# never be given --insecure-skip-tls-verify.
# The expected digests are pinned HERE rather than fetched from dl.k8s.io
# alongside the binary. A published kubectl.sha256 travels over the same channel
# as the binary it attests, so anyone able to tamper with one can tamper with
# both; a digest committed to this file is reviewed by a human and verified
# against the release at pin time. Kubernetes publishes no GPG signature for
# kubectl.sha256 (that URL is a 404) — the binary is cosign/sigstore-signed
# (kubectl.sig, kubectl.cert), which would need cosign and a Rekor round-trip in
# the build. The pinned digest gives the same integrity guarantee offline.
#
# To bump: set KUBECTL_VERSION to a release matching the target cluster's minor
# (one minor of API-server skew is all kubectl supports), then refresh both
# digests from
#   https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/{amd64,arm64}/kubectl.sha256
# Pinned 2026-09-30 for v1.36.5 against a v1.36 cluster.
ARG KUBECTL_SHA256_AMD64=33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e
ARG KUBECTL_SHA256_ARM64=88fc1aca8fd0c1b44fe379f67c39bd6858bdfc50241dc55775f84d0f5b31da3a
RUN if [ "$INSTALL_KUBECTL" = "true" ]; then \
      set -eux; \
      dpkgArch="$(dpkg --print-architecture)"; \
      case "${dpkgArch##*-}" in \
        amd64) ARCH='amd64'; SHA="${KUBECTL_SHA256_AMD64}";; \
        arm64) ARCH='arm64'; SHA="${KUBECTL_SHA256_ARM64}";; \
        *) echo "unsupported architecture for kubectl: ${dpkgArch}" >&2; exit 1;; \
      esac; \
      base="https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${ARCH}"; \
      curl --proto '=https' --tlsv1.2 -fsSLO "${base}/kubectl" && \
      echo "${SHA}  kubectl" | sha256sum --check && \
      install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
      rm -f kubectl && \
      kubectl version --client ; \
    fi

# kustomize. Digests pinned here for the same reason as kubectl's above; refresh
# them from the release's checksums.txt when bumping KUSTOMIZE_VERSION.
ARG KUSTOMIZE_SHA256_AMD64=029a7f0f4e1932c52a0476cf02a0fd855c0bb85694b82c338fc648dcb53a819d
ARG KUSTOMIZE_SHA256_ARM64=0953ea3e476f66d6ddfcd911d750f5167b9365aa9491b2326398e289fef2c142
RUN if [ "$INSTALL_KUSTOMIZE" = "true" ]; then \
      set -eux; \
      dpkgArch="$(dpkg --print-architecture)"; \
      case "${dpkgArch##*-}" in \
        amd64) ARCH='amd64'; SHA="${KUSTOMIZE_SHA256_AMD64}";; \
        arm64) ARCH='arm64'; SHA="${KUSTOMIZE_SHA256_ARM64}";; \
        *) echo "unsupported architecture for kustomize: ${dpkgArch}" >&2; exit 1;; \
      esac; \
      tarball="kustomize_v${KUSTOMIZE_VERSION}_linux_${ARCH}.tar.gz"; \
      curl --proto '=https' --tlsv1.2 -fsSLO "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/${tarball}" && \
      echo "${SHA}  ${tarball}" | sha256sum --check && \
      tar -xzf "${tarball}" -C /usr/local/bin kustomize && \
      rm -f "${tarball}" && \
      kustomize version ; \
    fi

# sandbox-exec gRPC server
COPY --from=builder /sandbox-exec /usr/local/bin/sandbox-exec

# Non-root user (UID 100 matches the session-manager pod security context).
# GID 100 (users) already exists in debian; reuse it.
RUN useradd -u 100 -g 100 -m -s /bin/bash orbit

# The run's shell path has to resolve in both containers. Codex bakes its shell
# into a snapshot it prefixes onto every command, so a command arriving here
# names the agent pod's path. There it is the orbit-shell proxy; here it is the
# shell that runs the command.
RUN mkdir -p /opt/orbit/shell && ln -sf /bin/bash /opt/orbit/shell/bash

# Workspaces directory — mounted from the agent pod's PVC at runtime.
RUN mkdir -p /workspaces && chown 100:100 /workspaces

# Strip setuid and setgid bits. no_new_privs already neutralises them; this keeps it true if that setting is ever dropped.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +

USER 100:100

EXPOSE 50051

CMD ["/usr/local/bin/sandbox-exec"]
