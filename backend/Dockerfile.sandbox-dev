# syntax=docker/dockerfile:1
#
# kora-sandbox-dev: the sandbox image for agents that work on kora itself. It
# carries kora's development tools at the versions in versions.hcl and no
# dependency caches. The chart does not register it. See
# docs/adr/2026-10-07-bundled-sandbox-images.md.
#
# It builds on kora-sandbox-node and copies golangci-lint and buf from
# kora-sandbox-go, so each pin and digest lives in one Dockerfile. Both build
# FROM kora-sandbox-base. docker-bake.hcl maps both names to their targets.

ARG GO_TOOLS_IMAGE=kora-sandbox-go
ARG BASE_IMAGE=kora-sandbox-node

FROM ${GO_TOOLS_IMAGE} AS go-tools

FROM ${BASE_IMAGE}

# Set from versions.hcl by docker-bake.hcl.
ARG PROTOC_GEN_GO_VERSION
ARG PROTOC_GEN_GO_GRPC_VERSION
ARG DEADCODE_VERSION
ARG GITLEAKS_VERSION

# Digests from the gitleaks release's checksums file, checked when pinned. A
# GITLEAKS_VERSION bump in versions.hcl needs new digests here.
ARG GITLEAKS_SHA256_AMD64=141c3b2dede46d8b3a53b47116da756bd223decc0374797559a6b50ecba5590c
ARG GITLEAKS_SHA256_ARM64=fd59a77b3d898ab14782264bf7a22db457871db56debc5d7ac3e30b64b379921

USER 0

COPY --from=go-tools /usr/local/bin/golangci-lint /usr/local/bin/buf /usr/local/bin/

# go install verifies each module against the Go checksum database.
RUN set -eux; \
    : "${PROTOC_GEN_GO_VERSION:?set PROTOC_GEN_GO_VERSION from versions.hcl}"; \
    : "${PROTOC_GEN_GO_GRPC_VERSION:?set PROTOC_GEN_GO_GRPC_VERSION from versions.hcl}"; \
    : "${DEADCODE_VERSION:?set DEADCODE_VERSION from versions.hcl}"; \
    : "${GITLEAKS_VERSION:?set GITLEAKS_VERSION from versions.hcl}"; \
    export GOPATH=/tmp/gopath GOCACHE=/tmp/gocache GOBIN=/usr/local/bin; \
    go install "google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}"; \
    go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION}"; \
    go install "golang.org/x/tools/cmd/deadcode@${DEADCODE_VERSION}"; \
    case "$(dpkg --print-architecture)" in \
      amd64) GL_ARCH=x64; GL_SHA="${GITLEAKS_SHA256_AMD64}";; \
      arm64) GL_ARCH=arm64; GL_SHA="${GITLEAKS_SHA256_ARM64}";; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1;; \
    esac; \
    tarball="gitleaks_${GITLEAKS_VERSION#v}_linux_${GL_ARCH}.tar.gz"; \
    cd /tmp; \
    curl --proto '=https' --tlsv1.2 -fsSLO "https://github.com/gitleaks/gitleaks/releases/download/${GITLEAKS_VERSION}/${tarball}"; \
    echo "${GL_SHA}  ${tarball}" | sha256sum --check; \
    tar -xzf "${tarball}" gitleaks; \
    install -m 0755 gitleaks /usr/local/bin/gitleaks; \
    rm -rf /tmp/*; \
    golangci-lint --version; buf --version; protoc-gen-go --version; \
    protoc-gen-go-grpc --version; deadcode -h 2>&1 | head -1; gitleaks version; \
    node --version; pnpm --version

USER 100:100
