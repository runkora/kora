# syntax=docker/dockerfile:1
#
# Session-manager image: the Go binaries and the native agent CLIs, with no Node.js.
# Claude Code and OpenCode (native binaries from npm), Codex (musl static binary) and the
# ACP adapters claude-agent-acp and codex-acp (compiled with Bun) are installed here so all
# three frameworks can run in the same container; framework selection stays a runtime concern.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder

WORKDIR /app

ENV GOPRIVATE=github.com/runkora/*
ENV GONOSUMDB=github.com/runkora/*
ENV GONOPROXY=github.com/runkora/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY . .

# The builder runs on the native build platform and Go cross-compiles for the
# target, so multi-arch builds never compile under QEMU emulation.
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora ./cmd/session-manager/main.go && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora-shell ./cmd/kora-shell/main.go && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora-runtime-mcp ./cmd/kora-runtime-mcp/main.go && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora-session-runner ./cmd/kora-session-runner/

# Stage only the YAML config files the session-manager binary loads at
# runtime, keeping Go source (config.go) out of the runtime image.
RUN mkdir -p /configs && \
    find /app/cmd/session-manager/config \
         /app/internal/platform/observability/config \
         /app/internal/platform/brand/config \
         /app/internal/platform/storage/config \
         /app/internal/platform/token/config \
         -maxdepth 2 -name '*.yaml' 2>/dev/null | while read -r f; do \
        rel="${f#/app/}"; \
        mkdir -p "/configs/$(dirname "$rel")"; \
        cp "$f" "/configs/$rel"; \
    done

# ── codex-acp stage ───────────────────────────────────────────────────────────
# codex-acp, the Codex ACP adapter, compiled from its pinned tag with Bun 1.4.4 or later
# (a Bun 1.3.11 binary loses its environment under Landlock) and the target's Bun runtime
# from the same pinned image. The autoload flags stop it loading a workspace bunfig.toml or .env.
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS bun-target
FROM --platform=$BUILDPLATFORM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS codex-acp
ARG CODEX_ACP_VERSION=2.6.0
ARG CODEX_ACP_COMMIT=f3208913693bd4d5171d6c6b9be5ec1ff96c6431
ARG TARGETARCH
RUN apk add --no-cache git=2.54.0-r0 nodejs=24.22.1-r1 npm=11.12.1-r0
RUN git clone --depth 1 --branch "v${CODEX_ACP_VERSION}" https://github.com/agentclientprotocol/codex-acp.git /src && \
    test "$(git -C /src rev-parse HEAD)" = "${CODEX_ACP_COMMIT}"
WORKDIR /src
# The bundled Codex binaries are skipped; the adapter runs the pinned codex through CODEX_PATH.
RUN npm ci --omit=optional --ignore-scripts
COPY --from=bun-target /usr/local/bin/bun /bun-target
RUN case "$TARGETARCH" in \
      amd64) target=bun-linux-x64-musl ;; \
      arm64) target=bun-linux-arm64-musl ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2 && exit 1 ;; \
    esac && \
    bun build src/index.ts --minify --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv \
      --target="$target" --compile-executable-path=/bun-target --outfile /codex-acp

# ── claude-agent-acp stage ────────────────────────────────────────────────────
# claude-agent-acp, the Claude Code ACP adapter, compiled from its pinned tag the same way.
# Its own copy of the Claude CLI is skipped; the adapter runs the pinned claude through
# CLAUDE_CODE_EXECUTABLE.
FROM --platform=$BUILDPLATFORM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS claude-agent-acp
ARG CLAUDE_AGENT_ACP_VERSION=0.101.0
ARG CLAUDE_AGENT_ACP_COMMIT=85aec26ef984a421fe8064ce43f60138a3372384
ARG TARGETARCH
RUN apk add --no-cache git=2.54.0-r0 nodejs=24.22.1-r1 npm=11.12.1-r0
RUN git clone --depth 1 --branch "v${CLAUDE_AGENT_ACP_VERSION}" https://github.com/agentclientprotocol/claude-agent-acp.git /src && \
    test "$(git -C /src rev-parse HEAD)" = "${CLAUDE_AGENT_ACP_COMMIT}"
WORKDIR /src
RUN npm ci --omit=optional --ignore-scripts
COPY --from=bun-target /usr/local/bin/bun /bun-target
RUN case "$TARGETARCH" in \
      amd64) target=bun-linux-x64-musl ;; \
      arm64) target=bun-linux-arm64-musl ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2 && exit 1 ;; \
    esac && \
    bun build src/binary-entry.ts --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv \
      --target="$target" --compile-executable-path=/bun-target --outfile /claude-agent-acp

# ── Agent CLI stage ───────────────────────────────────────────────────────────
# The claude and opencode CLIs from the lockfile in cmd/session-manager/agent-clis, so every
# build gets the same versions. npm installs each one's native binary for the target, and
# only those binaries reach the runtime image. Validate the opencode ACP protocol on upgrade.
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS agent-clis
COPY cmd/session-manager/agent-clis/package.json cmd/session-manager/agent-clis/package-lock.json /src/
RUN cd /src && \
    npm ci --omit=dev && \
    mkdir /out && \
    cp node_modules/@anthropic-ai/claude-code/bin/claude.exe /out/claude && \
    cp node_modules/opencode-ai/bin/opencode.exe /out/opencode

# ── Runtime stage ─────────────────────────────────────────────────────────────
# Alpine 3.24, the release the agent-clis stage is built on. Nothing here runs Node.js.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

WORKDIR /app

# bash, git: kora-session-runner does not let an agent execute either. Commands
#       run in the sandbox.
# curl: used to download the Codex musl binary below.
# ripgrep: OpenCode's grep, glob and list tools; it downloads rg from GitHub when none is on PATH,
#          and the agent pod cannot reach GitHub.
# libgcc, libstdc++: the Bun-compiled opencode, claude-agent-acp and codex-acp link them.
# Toolchains (Go and the rest) live only in the sandbox image, where commands run.
RUN apk add --no-cache ca-certificates bash git curl ripgrep libgcc libstdc++

# How Claude Code's Bash tool is routed into the sandbox:
#   - Claude Code IGNORES $SHELL; it resolves its shell from CLAUDE_CODE_SHELL.
#   - It only honors a CLAUDE_CODE_SHELL whose basename is a known shell
#     (bash/zsh/fish); anything else (e.g. "kora-shell") silently falls back to
#     /bin/bash. Verified empirically — see kora-shell's package doc.
#   - So kora-shell (the sandbox-routing Bash proxy) is exposed under a "bash"
#     basename via the symlink created below, and CLAUDE_CODE_SHELL points at it.
# kora-shell routes `-c` commands to the sandbox pod's gRPC exec server and refuses
# them when the run has no sandbox.
ENV SHELL=/opt/kora/shell/bash
ENV CLAUDE_CODE_SHELL=/opt/kora/shell/bash
# Managed settings outrank the project settings an agent can write in its workspace.
# They pin the shell to kora-shell, drop hooks from those files and refuse every
# plugin marketplace.
COPY cmd/session-manager/agent-clis/claude-managed-settings.json /etc/claude-code/managed-settings.json

# kora-session-runner lets a run execute only its harness binary, kora-shell,
# kora-runtime-mcp, their ELF interpreter, ripgrep for OpenCode, codex for codex-acp
# and claude for claude-agent-acp.
COPY --from=agent-clis /out/claude /out/opencode /usr/local/bin/
RUN claude --version && opencode --version

# Install Codex (musl-only statically linked binary; runs on Alpine without glibc).
# It comes from the npm registry's per-platform package, which carries the release's
# musl binary, so a GitHub releases outage does not block the image.
# Validate codex-acp against the new version on upgrade.
# Override at image build time: docker build --build-arg CODEX_VERSION=x.y.z, with
# the digests of the new codex-<version>-linux-<x64|arm64>.tgz files.
ARG CODEX_VERSION=0.142.1
ARG CODEX_SHA256_X64=3d09d9a193fcca05607182b68597bbe204b004fc894ec05e7de22515829c3dde
ARG CODEX_SHA256_ARM64=2f7cd7270950aa68f1e498c034cf39722f00ebcef068db0746909aad3deb1aa7
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then MUSL_ARCH="x86_64"; NPM_ARCH="x64"; SHA="${CODEX_SHA256_X64}"; \
    elif [ "$ARCH" = "aarch64" ]; then MUSL_ARCH="aarch64"; NPM_ARCH="arm64"; SHA="${CODEX_SHA256_ARM64}"; \
    else echo "Unsupported architecture: $ARCH" >&2 && exit 1; fi && \
    tgz="codex-${CODEX_VERSION}-linux-${NPM_ARCH}.tgz" && \
    curl -fsSLo "/tmp/${tgz}" "https://registry.npmjs.org/@openai/codex/-/${tgz}" && \
    echo "${SHA}  /tmp/${tgz}" | sha256sum -c && \
    tar -xzf "/tmp/${tgz}" -C /tmp "package/vendor/${MUSL_ARCH}-unknown-linux-musl/bin/codex" && \
    install -m 0755 "/tmp/package/vendor/${MUSL_ARCH}-unknown-linux-musl/bin/codex" /usr/local/bin/codex && \
    rm -rf "/tmp/${tgz}" /tmp/package

COPY --from=codex-acp /codex-acp /usr/local/bin/codex-acp
COPY --from=claude-agent-acp /claude-agent-acp /usr/local/bin/claude-agent-acp

# Non-root user: Claude Code refuses bypass permissions mode as root.
RUN addgroup -S kora && adduser -S kora -G kora

COPY --from=builder /configs/ ./
COPY --from=builder /kora ./kora
COPY --from=builder /kora-shell /usr/local/bin/kora-shell
# Expose kora-shell under a "bash" basename so Claude Code's CLAUDE_CODE_SHELL accepts it
# (it rejects non-shell basenames and falls back to /bin/bash). Dedicated dir, NOT on PATH,
# so the real /bin/bash is unaffected for every other consumer in the image.
RUN mkdir -p /opt/kora/shell && ln -sf /usr/local/bin/kora-shell /opt/kora/shell/bash
# Codex resolves its shell from the running user's passwd entry, not $SHELL, and
# classifies it by basename. Pointing kora's login shell at the proxy is what
# routes its tool commands into the sandbox. Codex reads passwd before PATH, so
# /bin/bash is unaffected for everything else, and a model naming /bin/bash is
# re-resolved back through here. The grep fails the build if the sed missed.
RUN sed -i 's#^kora:\(.*\):/sbin/nologin$#kora:\1:/opt/kora/shell/bash#' /etc/passwd && \
    getent passwd kora | grep -q ':/opt/kora/shell/bash$'
COPY --from=builder /kora-runtime-mcp /usr/local/bin/kora-runtime-mcp
COPY --from=builder /kora-session-runner /usr/local/bin/kora-session-runner

# Workspaces directory (matches config/base.yaml workspaces.basePath)
RUN mkdir -p /workspaces && chown kora:kora /workspaces /app

USER kora

EXPOSE 8090

CMD ["./kora"]
