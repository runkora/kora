    },
    "css-shadow-list": {
      "type": "string",
      "pattern": "^(?:inset\\s+)?(?:(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\(\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*(?:/\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*)?\\)|rgba?\\([\\d.%\\s,/]+\\))\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))(?:\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))){1,3}|(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))(?:\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))){1,3}(?:\\s+(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\(\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*(?:/\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*)?\\)|rgba?\\([\\d.%\\s,/]+\\)))?)(?:\\s*,\\s*(?:inset\\s+)?(?:(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\(\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*(?:/\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*)?\\)|rgba?\\([\\d.%\\s,/]+\\))\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))(?:\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))){1,3}|(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))(?:\\s+(?:0|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em))){1,3}(?:\\s+(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\(\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*(?:/\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*)?\\)|rgba?\\([\\d.%\\s,/]+\\)))?)){0,3}$"
    },
    "font-family-name": {
      "type": "string",
      "pattern": "^[\\p{L}\\p{N} \\-_,.]{1,64}$"
    },
    "hex-or-oklch": {
      "type": "string",
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|oklch\\(\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s+(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*(?:/\\s*(?:none|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)%?)\\s*)?\\))$"
    },
    "bundle-path": {
      "type": "string",
      "pattern": "^(?:(?!\\.\\.?/)[^/\\\\]+/)*(?!\\.\\.?$)[^/\\\\]+$"
    }
  }
