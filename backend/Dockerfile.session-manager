# syntax=docker/dockerfile:1
#
# Session-manager image: Go binary + Node.js (required for the claude CLI).

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS builder

WORKDIR /app

ENV GOPRIVATE=github.com/clear-route/*
ENV GONOSUMDB=github.com/clear-route/*
ENV GONOPROXY=github.com/clear-route/*

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o /orbit ./cmd/session-manager/main.go

RUN find /app -path "*/config/*.yaml" | while read f; do \
        rel="${f#/app/}"; \
        mkdir -p "/configs/$(dirname "$rel")"; \
        cp "$f" "/configs/$rel"; \
    done

# ── Runtime stage ─────────────────────────────────────────────────────────────
# Node.js 22 alpine: required for the claude CLI subprocess.
FROM node:22-alpine

WORKDIR /app

# bash: required by Claude Code's Bash tool (it checks $SHELL and exec()s bash directly).
# git:  required by Claude Code for git operations inside workspaces.
# go:   required so Claude Code can build/run Go programs in agent workspaces.
RUN apk add --no-cache ca-certificates bash git go

# Claude Code's Bash tool reads $SHELL to locate the shell binary.
# Alpine does not set SHELL for system users; without this, all Bash tool calls fail.
ENV SHELL=/bin/bash

# Install claude CLI. Pin to the tested major version.
RUN npm install -g @anthropic-ai/claude-code@2

# Non-root user: claude --dangerously-skip-permissions refuses to run as root.
RUN addgroup -S orbit && adduser -S orbit -G orbit

COPY --from=builder /configs/ ./
COPY --from=builder /orbit ./orbit

# Workspaces directory (matches config/base.yaml workspaces.basePath)
RUN mkdir -p /workspaces && chown orbit:orbit /workspaces /app

USER orbit

EXPOSE 8090

CMD ["./orbit"]
