# syntax=docker/dockerfile:1
#
# sandbox-mount node agent (docs/adr/2026-10-08-sandbox-workspace-mount.md): the
# Go binary plus nfs-utils for the kernel NFS server's rpc.nfsd, rpc.mountd and exportfs.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY . .

ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora ./cmd/sandbox-mount

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63

# Runs as root: the agent mounts filesystems and starts the kernel NFS server.
RUN apk add --no-cache nfs-utils && mkdir -p /var/lib/nfs /exports

WORKDIR /app
COPY --from=builder /app/cmd/sandbox-mount/config/base.yaml ./cmd/sandbox-mount/config/base.yaml
COPY --from=builder /kora ./kora

ENTRYPOINT ["/app/kora"]
