# syntax=docker/dockerfile:1
#
# Build the orbit-operator binary.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS builder

WORKDIR /app

ENV GOPRIVATE=github.com/clear-route/*
ENV GONOSUMDB=github.com/clear-route/*
ENV GONOPROXY=github.com/clear-route/*

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY backend/ .

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux go build -o /orbit-operator ./cmd/operator/main.go

# Stage only the YAML config files the operator binary loads at runtime,
# keeping Go source (config.go) out of the runtime image. Operator does not
# import internal/platform/storage.
RUN mkdir -p /configs && \
    find /app/cmd/operator/config \
         /app/internal/platform/observability/config \
         -maxdepth 2 -name '*.yaml' 2>/dev/null | while read -r f; do \
        rel="${f#/app/}"; \
        mkdir -p "/configs/$(dirname "$rel")"; \
        cp "$f" "/configs/$rel"; \
    done

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

# Non-root user matching the securityContext in the chart.
RUN addgroup -g 65532 nonroot && adduser -u 65532 -G nonroot -s /sbin/nologin -D nonroot

WORKDIR /app

RUN apk add --no-cache ca-certificates

# Process-default config files, same relative layout as local development.
COPY --from=builder --chown=65532:65532 /configs/ ./

COPY --from=builder --chown=65532:65532 /orbit-operator ./orbit

USER 65532

EXPOSE 8081 9443
CMD ["./orbit"]
