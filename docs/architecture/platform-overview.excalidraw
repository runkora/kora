      "updated": 1772614554805,
      "link": null,
      "locked": false,
      "text": "All core infrastructure components are \ncluster-internal only. They are accessed\nexclusively by platform layer services,\nno direct access from agent or MCP\nworkloads. Network isolation is\nenforced by Cilium. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "All core infrastructure components are \ncluster-internal only. They are accessed exclusively by platform layer services, no direct access from agent or MCP workloads. Network isolation is enforced by Cilium. ",
      "autoResize": false,
      "lineHeight": 1.25
    }
