#!/usr/bin/env bash
# =============================================================================
# versions.env — Single source of truth for all pinned tool and image versions
#
# Both dev-cluster-up.sh and install-tools-cluster.sh source this file.
# When bumping a version, change it here only. The image tags below must stay
# in sync with the tags used in infrastructure/base/spire/*.yaml — if you
# change a SPIRE image version, update the kustomize manifests to match.
# =============================================================================

# ── Cluster tooling ───────────────────────────────────────────────────────────
K3D_VERSION="v5.6.3"
KUBECTL_VERSION="v1.29.4"
ISTIO_VERSION="1.21.2"
HELM_VERSION="v3.14.4"

# ── SPIRE images (must match tags in infrastructure/base/spire/*.yaml) ────────
SPIRE_SERVER_VERSION="1.9.4"
SPIRE_AGENT_VERSION="1.9.4"
SPIRE_CONTROLLER_MANAGER_VERSION="0.6.3"

# ── Supporting images ─────────────────────────────────────────────────────────
BUSYBOX_VERSION="1.36.1"
