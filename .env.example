# =============================================================================
# Orbit Control Plane — Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   # or: make env
#
# NEVER commit .env to version control.
# Secrets (passwords, keys, client secrets) must never go in YAML config files.
# =============================================================================

# ---------------------
# Infrastructure
# ---------------------
# There is a known bug on macOS using Colima and k3d, which uses 192.168.5.2 as the DNS server
# which is the Lima VM host address. Setting K3D_FIX_DNS to 0 disables this behaviour.
K3D_FIX_DNS=0

# ---------------------
# Application
# ---------------------
# Tier 1 local dev only (make dev — binary running on the host, not in cluster).
# Selects env-specific YAML config overrides: config/{APP_ENV}.yaml for each
# platform module (identity token TTLs, storage SSL settings, etc.).
# In-cluster deployments (Tier 2+) do NOT use APP_ENV — security-sensitive
# settings are injected as explicit ORBIT_* env vars by the Helm chart.
APP_ENV=local

# ─── PostgreSQL ───────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_USER=orbit
DB_PASSWORD=orbit
DB_NAME=orbit

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=orbit

# ─── Dex (local OIDC provider) ────────────────────────────────────────────────
#
# Dex provides a real, standards-compliant local OIDC server for the Device
# Authorization Grant flow — no cloud accounts needed.
#
# Dex credentials live in config/dex/.env (gitignored), NOT here.
# Generate that file with:  make dex-hash password=<yourpassword>
# The default "password" is set automatically during bootstrap via `make dex-env`.

# ─── OIDC / Federated Identity ────────────────────────────────────────────────
#
# OIDC configuration is now per-tenant, defined in config/tenants.yaml.
# There are no global ORBIT_OIDC_* variables — each tenant declares its own
# issuerURL, clientID, and (optionally) clientSecretRef in the tenant registry.
#
# Local dev: Dex started automatically by `make dev-up`.
#   Issuer:    http://dex.orbit.test:5556/dex
#   Client ID: orbit-local  (public client — no secret required)
#   Test user: dev@orbit.test / password
#
# Run `make auth-device` to authenticate and get a platform JWT.

# ─── Multi-Tenant Registry (ADR-0026) ─────────────────────────────────────────
#
# Path to the tenant registry YAML file read by the identity service.
# This file is binary-independent — it is NOT baked into the image.
#
# THIS VARIABLE IS FOR TIER 1 LOCAL DEV ONLY (make dev / air hot-reload on host).
# When running without a cluster, there is no operator, no ConfigMap, and no
# volume mount — the identity service reads config/tenants.yaml directly from
# the filesystem via this env var.
#
# config/tenants.yaml is committed to the repo and pre-wired for the local
# Dex OIDC provider started by `make dev-up`. Do not change this path for
# standard local development.
#
# For cluster dev (make cluster-operator + make cluster-deploy):
#   Do NOT set this variable. The operator builds the orbit-tenants ConfigMap
#   from OrbitTenant CRs and mounts it into the identity pod automatically.
#   Setting this to a local path has no effect inside the cluster.
#
# See: deploy/local/tenants/example.yaml  — OrbitTenant CR for cluster dev
#      docs/adr/0026-tenant-registration-and-oidc-provider-binding.md
#
ORBIT_TENANTS_CONFIG=../config/tenants.yaml

# Per-tenant OIDC client secrets (confidential clients only — ADR-0029).
# In cluster mode the orbit-operator aggregates client secrets from per-tenant
# Kubernetes Secrets into orbit-tenant-oidc-secrets (orbit-system) and the
# identity pod picks them up via a file watcher. No env vars are used.
#
# In Tier 1 local dev (make dev), the local Dex client is a PUBLIC client —
# no client secret is required and no variable needs to be set here.
#
# The variable name follows the pattern ORBIT_TENANT_<TENANT_ID_UPPER>_OIDC_CLIENT_SECRET.
# For the default local "example" tenant:
ORBIT_TENANT_EXAMPLE_OIDC_CLIENT_SECRET=

# ─── Platform JWT Signing ─────────────────────────────────────────────────────
#
# RSA private key used to sign Orbit platform JWTs (RS256).
# If unset, an ephemeral 2048-bit key is generated at startup — acceptable for
# local dev, but tokens will not survive restarts and the JWKS endpoint will
# return a different key each run.
#
# LOCAL DEV — recommended approach (file, no multiline headaches):
#   make gen-signing-key          # writes secrets/signing.key  (gitignored)
#   # then ensure this is in your .env:
#   ORBIT_TOKEN_SIGNING_KEY_FILE=secrets/signing.key
#
# CI / PRODUCTION — inject the PEM as a real multiline secret via your
# secrets manager (Kubernetes Secret, GitHub Actions secret, etc.) and set:
#   ORBIT_TOKEN_SIGNING_KEY=<full PEM with real newlines>
#
# Only one of the two variables needs to be set. FILE takes priority.
ORBIT_TOKEN_SIGNING_KEY_FILE=../secrets/signing.key

# ─── Orbit Tenant (for make auth-device) ──────────────────────────────────────
#
# The Orbit tenant ID to authenticate against.
# For local dev, "example" matches the tenant defined in config/tenants.yaml.
ORBIT_TENANT_ID=example

# ─── Inference Gateway ───────────────────────────────────────────────────────
#
# JWKS URL used by the inference gateway to verify platform JWTs.
# Points at the identity service's public key endpoint — no private key needed.
#
# Local dev (identity service running via `make run-identity`):
ORBIT_API_BASE=http://localhost:8080/api/v1
ORBIT_TOKEN_JWKS_URL=http://localhost:8080/api/v1/identity/.well-known/jwks.json

# ─── Inference Gateway — Provider credentials ────────────────────────────────
#
# Each provider is opt-in via *_ENABLED=true. Unset or false = connector
# disabled; inference requests for that provider return 400.
#
# ── AWS Bedrock ───────────────────────────────────────────────────────────────
#
# Local dev: export STS temporary credentials, or use a long-lived IAM key.
# Production (EKS): use IRSA — no key needed; omit AWS_ACCESS_KEY_ID /
#   AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN entirely.
#
# BEDROCK_ENABLED=true
# BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=           # required when using STS/assume-role credentials
#
# ── Google Cloud Vertex AI ────────────────────────────────────────────────────
#
# Auth uses Application Default Credentials (ADC) exclusively — no API key.
#
# Local dev:  run `gcloud auth application-default login` once.
#             ADC credentials are stored at
#             ~/.config/gcloud/application_default_credentials.json and
#             picked up automatically — no GOOGLE_APPLICATION_CREDENTIALS
#             env var needed. This mirrors GKE Workload Identity exactly:
#             both rely on the GCP SDK finding credentials transparently.
#
# Production (GKE): attach a GCP service account to the pod via Workload
#             Identity binding — no credentials file, no env var required.
#
# VERTEX_ENABLED=true
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# Optional: override region for Claude-on-Vertex (Claude 4 models require us-east5).
# Defaults to VERTEX_LOCATION when unset.
VERTEX_ANTHROPIC_LOCATION=us-east5    # region that hosts your Vertex AI endpoint
#
# ── Azure OpenAI ─────────────────────────────────────────────────────────────
#
# AZURE_ENABLED=true
# AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
#
# The root Makefile sources this file (-include .env) and re-exports every
# variable into sub-shell environments (`export` directive, lines 4-6).
# This means `make frontend-dev` and `make frontend-build` automatically
# propagate all vars below to the pnpm process — no separate
# frontend/.env.local required when running through Make targets.
#
# If you run `pnpm dev` directly from the frontend/ directory (outside Make),
# create a frontend/.env.local that re-exports the values you need — that file
# is gitignored and will not be committed.

# URL of the Go control plane API (server-side BFF only — never sent to the browser)
ORBIT_API_URL=http://localhost:8080/api/v1

# BFF session secret — must be at least 32 characters.
# Generate with: openssl rand -hex 32
BFF_SESSION_SECRET=

# Public base URL of this Next.js app (NEXT_PUBLIC_ prefix exposes it to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

