# =============================================================================
# Orbit Frontend — Environment Variables
# =============================================================================
#
# These are read by the Next.js BFF (Backend-For-Frontend) server layer in
# frontend/src/server/config.ts. The server module throws on boot if any of the
# REQUIRED vars below is missing — there are no defaults.
#
# Two ways to provide them:
#
#   1. `make frontend-dev` (recommended) — the root Makefile sources the repo
#      root `.env` and re-exports every variable into the pnpm sub-shell, so the
#      root `.env` already covers the frontend. You do NOT need this file when
#      running through Make.
#
#   2. `pnpm dev` run directly from frontend/ (outside Make) — Next.js does NOT
#      see the root `.env`. Copy this file to `frontend/.env.local` and fill in
#      the values:
#
#        cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real secrets.
#
# Values below are the LOCAL dev defaults — they assume the backend services
# are running on the host (see backend run targets in the root Makefile).
# In-cluster (Tier 2+) values are injected by the orbit-frontend-config
# ConfigMap + orbit-frontend-secrets Secret and look like
# http://orbit-identity.orbit-system/api/v1 — see frontend/Dockerfile.
# =============================================================================

# ─── REQUIRED — backend service URLs (server-side BFF only) ───────────────────
#
# All five URLs below are read by the BFF on the server and are NEVER sent to
# the browser. Trailing slashes are stripped automatically.

# Go control plane / identity API. Backs auth, sessions, and most admin proxies.
# Local: `make run-identity` listens on :8080.
ORBIT_API_URL=http://localhost:8080/api/v1

# Inference gateway. The BFF proxies model listing + chat through it.
# Must include the versioned /v1 path prefix.
# Local: `make run-inference-gateway` listens on :8081.
INFERENCE_GATEWAY_URL=http://localhost:8081/v1

# Policy service PAP. The BFF proxies grant / role / vocabulary / route admin
# endpoints through it. Must include the /api/v1 path prefix.
# Local: run the policy-service binary (backend/cmd/policy-service) on :8083.
POLICY_SERVICE_URL=http://localhost:8083/api/v1

# Policy gateway (PDP). The BFF calls it to fetch the principal's effective
# scope set on login and token refresh. Must include the /v1 path prefix.
# Local: run the policy-gateway binary (backend/cmd/policy-gateway) on :8084.
POLICY_GATEWAY_URL=http://localhost:8084/v1

# orbit-agents service. The BFF proxies agent-type / run CRUD + SSE streaming.
#
# HONEST NOTE: orbit-agents binds :8080 — the SAME host port as the identity
# service (ORBIT_API_URL above), so the two CANNOT both run on the host at once.
# There is no `make run-agents` target and no dedicated host port for agents;
# it is deployed via the Helm chart in the Tier 2 cluster only. As a result:
#   - The agents-related pages of the dashboard require the in-cluster
#     deployment (`make cluster-operator` / `make cluster-deploy`), where this
#     resolves to http://orbit-agents.orbit-system.
#   - For host-only dev (identity + inference + policy on the host), the rest of
#     the app boots fine, but agents calls will fail. The placeholder below only
#     exists to satisfy the BFF's required-env check at boot — point it at the
#     cluster service, or run agents in the cluster and port-forward to it.
# (The old root .env.example value of :8082 is WRONG — nothing binds :8082.)
ORBIT_AGENTS_URL=http://localhost:8080

# Base URL of the MCP tool-gateway (proxy deployment, port 8096). The BFF reads
# its read-only tool catalog (GET /v1/catalog) for the MCP Servers page. The
# tool-gateway runs only in-cluster; point this at the cluster service (or a
# port-forward). e.g. http://localhost:8096
TOOL_GATEWAY_URL=http://localhost:8096

# ─── REQUIRED — BFF session secret ────────────────────────────────────────────
#
# Signs/verifies the iron-session cookie. MUST be at least 32 characters or the
# BFF session layer throws. An empty/short value breaks login silently.
# Generate one with:
#   openssl rand -base64 32
BFF_SESSION_SECRET=

# ─── Browser-exposed config (NEXT_PUBLIC_*) ───────────────────────────────────
#
# These are inlined into the client bundle by Next.js at build time AND read at
# runtime by server code. They are intentionally public.

# Public base URL this Next.js app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth 2.0 / OIDC redirect URI. Must EXACTLY match the redirect URI registered
# in the Dex client (or your cloud IdP). For local dev this is the Next.js auth
# callback route.
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
