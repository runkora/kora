# Orbit Control Plane - Example Root Environment Variables
# =================================================
# Loaded by the Makefile for build and database targets.
# Copy this file to .env and fill in your values.
# DO NOT commit the .env file — it is gitignored.

# ---------------------
# Application
# ---------------------
# Selects which YAML config file to load: cmd/orbit/config/{APP_ENV}.yaml
# Supported: local | development | production
APP_ENV=local

# ---------------------
# Database (PostgreSQL)
# ---------------------
# Used by make db-*, migrate-* targets to construct DB_URL.
DB_USER=orbit
DB_PASSWORD=orbit
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit
