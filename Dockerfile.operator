# syntax=docker/dockerfile:1
#
# Build the orbit-operator binary.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS builder

WORKDIR /app

ENV GOPRIVATE=github.com/runkora/*
ENV GONOSUMDB=github.com/runkora/*
ENV GONOPROXY=github.com/runkora/*

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY backend/ .

# The builder runs on the native build platform and Go cross-compiles for the
# target, so multi-arch builds never compile under QEMU emulation.
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /orbit-operator ./cmd/operator/main.go

# Stage only the YAML config files the operator binary loads at runtime,
# keeping Go source (config.go) out of the runtime image. Operator does not
# import internal/platform/storage.
RUN mkdir -p /configs && \
    find /app/cmd/operator/config \
         /app/internal/platform/observability/config \
         /app/internal/platform/brand/config \
         -maxdepth 2 -name '*.yaml' 2>/dev/null | while read -r f; do \
        rel="${f#/app/}"; \
        mkdir -p "/configs/$(dirname "$rel")"; \
        cp "$f" "/configs/$rel"; \
    done

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0

# Non-root user matching the securityContext in the chart.
RUN addgroup -g 65532 nonroot && adduser -u 65532 -G nonroot -s /sbin/nologin -D nonroot

WORKDIR /app

RUN apk add --no-cache ca-certificates

# Process-default config files, same relative layout as local development.
COPY --from=builder --chown=65532:65532 /configs/ ./

COPY --from=builder --chown=65532:65532 /orbit-operator ./orbit

USER 65532

EXPOSE 8081 9443
CMD ["./orbit"]
