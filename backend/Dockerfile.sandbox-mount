# syntax=docker/dockerfile:1
#
# sandbox-mount node agent (docs/adr/2026-10-08-sandbox-workspace-mount.md): the
# Go binary plus nfs-utils for the kernel NFS server's rpc.nfsd, rpc.mountd and exportfs.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY . .

ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /kora ./cmd/sandbox-mount

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2

# Runs as root: the agent mounts filesystems and starts the kernel NFS server.
RUN apk add --no-cache nfs-utils && mkdir -p /var/lib/nfs /exports

WORKDIR /app
COPY --from=builder /app/cmd/sandbox-mount/config/base.yaml ./cmd/sandbox-mount/config/base.yaml
COPY --from=builder /kora ./kora

ENTRYPOINT ["/app/kora"]
